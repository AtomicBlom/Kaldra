<Project Sdk="Loom.Sdk">

  <!-- The whole build configuration for a Loom app. Sdk="Loom.Sdk" (pinned in global.json) makes one project
       build a native desktop exe (dotnet build) or a WebGPU browser app (dotnet publish -r browser-wasm) from
       the same source: the RID selects the base SDK, backend, host, and shader output mode. Point
       LoomShaderSourceDir at your Slang shaders; everything else is defaulted. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LoomShaderSourceDir>$(MSBuildProjectDirectory)\Shaders</LoomShaderSourceDir>
  </PropertyGroup>

</Project>
