<ContentControl xmlns="https://github.com/AtomicBlom/SUIsei/ui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:suisei="https://github.com/AtomicBlom/SUIsei/extensions"
        x:Class="HelloUI.MainPage"
        suisei:InputPane.AvoidsKeyboard="True">
	<!-- The page fills the surface and keeps clear of the on-screen keyboard: while it is up, the scroll viewer shrinks to
	     the part of the screen above it and scrolls the focused text box, low on the card, back into view. -->
	<ScrollViewer x:Name="Scroller">
		<Border x:Name="Card" HorizontalAlignment="Center" VerticalAlignment="Center" Width="360" Margin="0,16,0,16"
		        CornerRadius="20" BorderThickness="2" BorderBrush="#78B4FF" Padding="24,20,24,24">
			<StackPanel Orientation="Vertical">
				<TextBlock x:Name="TitleLabel" FontSize="26" Text="Hello from SUIsei" />
				<TextBlock x:Name="DeviceLabel" FontSize="13" Margin="0,6,0,0" Text="{x:Bind ViewModel.Device, Mode=OneWay}" />
				<TextBlock x:Name="PlatformLabel" FontSize="13" Margin="0,2,0,0" Text="{x:Bind ViewModel.Platform}" />
				<TextBlock x:Name="RuntimeLabel" FontSize="13" Margin="0,2,0,14" Text="{x:Bind ViewModel.Runtime}" />
				<TextBlock x:Name="InputLabel" FontSize="13" Text="{x:Bind ViewModel.LastInput, Mode=OneWay}" />
				<TextBlock x:Name="PadLabel" FontSize="13" Margin="0,2,0,0" Text="{x:Bind ViewModel.PadState, Mode=OneWay}" />
				<TextBlock x:Name="KeyboardLabel" FontSize="13" Margin="0,2,0,16" Text="{x:Bind ViewModel.Keyboard, Mode=OneWay}" />
				<TextBlock x:Name="CountLabel" FontSize="20" Text="{x:Bind ViewModel.Count, Mode=OneWay}" />
				<Button x:Name="TapButton" HorizontalAlignment="Left" Width="200" Height="56" Margin="0,10,0,20" Click="{x:Bind OnTapClick}">
					<TextBlock Text="Tap me" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
				</Button>
				<TextBlock x:Name="SliderLabel" FontSize="16" Text="{x:Bind ViewModel.SliderText, Mode=OneWay}" />
				<Slider x:Name="ValueSlider" Minimum="0" Maximum="100" Value="50" Height="48" />
				<TextBox x:Name="NameBox" Height="44" FontSize="16" Margin="0,10,0,0" />
				<CheckBox x:Name="OptionCheck" Margin="0,10,0,0" Content="A checkbox to toggle" />
			</StackPanel>
		</Border>
	</ScrollViewer>
</ContentControl>
