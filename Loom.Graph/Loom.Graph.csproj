<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Label="NuGet">
    <PackageId>Loom.Graph</PackageId>
    <Description>Backend-neutral render-graph execute layer for Loom. Topological scheduling, derived barriers, transient memory aliasing — no graphics-API types.</Description>
    <PackageTags>vulkan;directx12;rendergraph;gamedev;graphics;dotnet</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Execute layer. Backend-agnostic: NO Silk.NET/Vulkan reference (CLAUDE.md cardinal invariant). -->
  <ItemGroup>
    <ProjectReference Include="..\Loom.Core\Loom.Core.csproj" />
  </ItemGroup>

</Project>
