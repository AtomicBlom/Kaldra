<Project Sdk="Microsoft.NET.Sdk">

  <!-- The engine owns its infrastructure shaders (tonemap/blit/fullscreen/exposure/imgui/debugview) and
       ships them embedded in this assembly, so consuming apps don't carry them. Import only the shared
       shader-compile machinery (not the app SDK), so the backend never self-references through backend
       selection. The compiled .spv/.json become EmbeddedResource (Embed mode). -->
  <Import Project="..\build\Loom.Sdk\Loom.Shaders.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The marshaling seam is pointer-heavy interop. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Engine shaders are backend-neutral Slang source shared by every backend (..\Loom.Shaders\Shaders); each
         backend compiles + embeds its own artifact from them (Vulkan → .spv here, DX12 → signed .dxil), so the
         shaders aren't owned by any one backend. Embedded under the manifest prefix "Loom.Vulkan.Shaders." (= $(AssemblyName).Shaders.). -->
    <LoomShaderSourceDir>$(MSBuildProjectDirectory)\..\Loom.Shaders\Shaders</LoomShaderSourceDir>
    <LoomShaderOutputMode>Embed</LoomShaderOutputMode>
    <!-- The Vulkan backend emits SPIR-V only; never DXIL (even in a -p:UseDX12=true build, where the flag would
         otherwise default it on). Loom.DX12 is the one that compiles these shared shaders to DXIL. -->
    <LoomEmitDxil>false</LoomEmitDxil>
    <!-- Built without ImGui (UseImGui=false): don't compile/embed the ImGui shader either. -->
    <LoomShaderExclude Condition="'$(UseImGui)' != 'true'">$(LoomShaderSourceDir)\imgui.slang</LoomShaderExclude>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Loom.Graph\Loom.Graph.csproj" />
    <!-- Neutral asset layer: the M13 shader hot-reload watcher (no graphics types). -->
    <ProjectReference Include="..\Loom.Assets\Loom.Assets.csproj" />
    <!-- VMASharp (RaymondEllis fork): pure-managed VMA port on Silk.NET 2.23/net10, MIT, as a submodule.
         Deliberately NOT in Loom.slnx so `dotnet format` never reformats vendored code; the ProjectReference
         still builds it transitively. The transient-memory aliaser (M4) builds on it. -->
    <ProjectReference Include="..\external\VMASharp\VMASharp\VMASharp.csproj" />
  </ItemGroup>

  <!-- The first backend. The Vulkan/Silk.NET stack is quarantined here. -->
  <ItemGroup>
    <PackageReference Include="Silk.NET.Vulkan" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.EXT" />
    <PackageReference Include="Silk.NET.Maths" />
    <!-- ImGui rendering is inherently backend-specific (like imgui_impl_vulkan), so the ImGui Vulkan
         renderer lives here. Only Loom.Vulkan + the host see ImGui.NET; Loom.Core/Graph stay UI-agnostic.
         Gated on <UseImGui> (repo-wide, Directory.Build.props) — off drops the dependency entirely. -->
    <PackageReference Include="ImGui.NET" Condition="'$(UseImGui)' == 'true'" />
    <!-- Hermetic slangc for compiling the engine's own shaders (bundled in the package; win-x64 / win-arm64). -->
    <PackageReference Include="Slang.Sdk" GeneratePathProperty="true" PrivateAssets="all" ExcludeAssets="compile;runtime" />
  </ItemGroup>

  <!-- Shared shader-compile targets (after the body, so LoomShaderSourceDir is set). -->
  <Import Project="..\build\Loom.Sdk\Loom.Shaders.targets" />

</Project>
