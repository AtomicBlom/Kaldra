<Project>

  <!-- SDL 3, for the desktop host's gamepads (SdlGamepadPump). Not a package: SDL's own release builds, pinned by version
       and SHA-256, downloaded once per machine into a cache and copied out with the app as runtimes/<rid>/native/SDL3.dll,
       the layout Ultz.Native.GLFW ships glfw3.dll in. Nothing binary is kept in git; moving to a newer SDL is the version
       and the two hashes below. SDL publishes Windows builds only (x64, arm64); elsewhere nothing is fetched and the host
       reads pads through GLFW, as it does wherever SDL3.dll fails to load. -->

  <PropertyGroup>
    <LoomSdl3Version>3.4.20</LoomSdl3Version>
    <LoomSdl3HashWinX64>368BED8B24E44AD9EA372990814F2343FCFB9E468ABB7F8F4A3BC146C7304752</LoomSdl3HashWinX64>
    <LoomSdl3HashWinArm64>51C292EAFC114EA3C63519FA2F5413A486979769D5444A636296F8A61C737267</LoomSdl3HashWinArm64>
    <LoomSdl3Url>https://github.com/libsdl-org/SDL/releases/download/release-$(LoomSdl3Version)</LoomSdl3Url>
    <LoomSdl3Cache Condition="'$(LoomSdl3Cache)' == '' and '$(LOCALAPPDATA)' != ''">$(LOCALAPPDATA)\Loom\native\SDL3\$(LoomSdl3Version)</LoomSdl3Cache>
    <LoomSdl3Enabled Condition="'$(LoomSdl3Enabled)' == '' and $([MSBuild]::IsOSPlatform('Windows')) and '$(LoomSdl3Cache)' != ''">true</LoomSdl3Enabled>
  </PropertyGroup>

  <!-- Which builds go out: the one matching a Windows RID when there is one, both otherwise (an AnyCPU app runs as the
       machine's architecture, and the host picks the folder to match). An app referencing this project builds it
       without its RID (the SDK drops it for a library), so this sees none and hands both up; the Loom SDK's Sdk.targets
       keeps only the app's own, by its runtimes/<rid>/native folder, in a publish for one runtime. -->
  <ItemGroup Condition="'$(LoomSdl3Enabled)' == 'true'">
    <LoomSdl3Arch Include="x64" Hash="$(LoomSdl3HashWinX64)" Condition="'$(RuntimeIdentifier)' == '' or '$(RuntimeIdentifier)' == 'win-x64'" />
    <LoomSdl3Arch Include="arm64" Hash="$(LoomSdl3HashWinArm64)" Condition="'$(RuntimeIdentifier)' == '' or '$(RuntimeIdentifier)' == 'win-arm64'" />
  </ItemGroup>

  <ItemGroup Condition="'$(LoomSdl3Enabled)' == 'true'">
    <None Include="$(LoomSdl3Cache)\win-x64\SDL3.dll" Link="runtimes\win-x64\native\SDL3.dll" Condition="'@(LoomSdl3Arch->AnyHaveMetadataValue('Identity', 'x64'))' == 'true'"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="$(LoomSdl3Cache)\win-x64\LICENSE.txt" Link="runtimes\win-x64\native\SDL3.LICENSE.txt" Condition="'@(LoomSdl3Arch->AnyHaveMetadataValue('Identity', 'x64'))' == 'true'"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="$(LoomSdl3Cache)\win-arm64\SDL3.dll" Link="runtimes\win-arm64\native\SDL3.dll" Condition="'@(LoomSdl3Arch->AnyHaveMetadataValue('Identity', 'arm64'))' == 'true'"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="$(LoomSdl3Cache)\win-arm64\LICENSE.txt" Link="runtimes\win-arm64\native\SDL3.LICENSE.txt" Condition="'@(LoomSdl3Arch->AnyHaveMetadataValue('Identity', 'arm64'))' == 'true'"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- Fetched before the build, so the files above exist when they are copied. A download that fails (offline) warns and
       builds on without SDL; a hash that doesn't match fails the build. -->
  <Target Name="LoomFetchSdl3" BeforeTargets="BeforeBuild;GetCopyToOutputDirectoryItems" Condition="'$(LoomSdl3Enabled)' == 'true'"
          Inputs="$(MSBuildThisFileFullPath)" Outputs="@(LoomSdl3Arch->'$(LoomSdl3Cache)\win-%(Identity)\SDL3.dll')">
    <DownloadFile SourceUrl="$(LoomSdl3Url)/SDL3-$(LoomSdl3Version)-win32-%(LoomSdl3Arch.Identity).zip" DestinationFolder="$(LoomSdl3Cache)"
                  Condition="!Exists('$(LoomSdl3Cache)\win-%(LoomSdl3Arch.Identity)\SDL3.dll')" ContinueOnError="WarnAndContinue" Retries="2" />
    <VerifyFileHash File="$(LoomSdl3Cache)\SDL3-$(LoomSdl3Version)-win32-%(LoomSdl3Arch.Identity).zip" Hash="%(LoomSdl3Arch.Hash)" Algorithm="SHA256"
                    Condition="Exists('$(LoomSdl3Cache)\SDL3-$(LoomSdl3Version)-win32-%(LoomSdl3Arch.Identity).zip') and !Exists('$(LoomSdl3Cache)\win-%(LoomSdl3Arch.Identity)\SDL3.dll')" />
    <Unzip SourceFiles="$(LoomSdl3Cache)\SDL3-$(LoomSdl3Version)-win32-%(LoomSdl3Arch.Identity).zip" DestinationFolder="$(LoomSdl3Cache)\win-%(LoomSdl3Arch.Identity)"
           Condition="Exists('$(LoomSdl3Cache)\SDL3-$(LoomSdl3Version)-win32-%(LoomSdl3Arch.Identity).zip') and !Exists('$(LoomSdl3Cache)\win-%(LoomSdl3Arch.Identity)\SDL3.dll')" />
    <Warning Text="SDL $(LoomSdl3Version) could not be fetched for win-%(LoomSdl3Arch.Identity); the desktop host will read gamepads through GLFW"
             Condition="!Exists('$(LoomSdl3Cache)\win-%(LoomSdl3Arch.Identity)\SDL3.dll')" />
  </Target>

</Project>
