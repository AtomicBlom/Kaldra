<Project Sdk="Microsoft.NET.Sdk">

  <!-- The UI shader (Shaders/ui.slang) lives with this integration, not the engine: the shared shader-compile
       machinery compiles it to loose SPIR-V (+ reflection JSON) and signed DXIL under shaders\, which flow to the
       consuming app's output. The backend resolves it there by the "ui" technique name (its loose-file fallback),
       so a backend built without this package carries no UI shader. Import only the shader-compile machinery —
       NOT the app SDK / backend selection. -->
  <Import Project="..\build\BinaryVibrance.Kaldra.Sdk\Kaldra.Shaders.props" />

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Loose .spv/.json (+ signed DXIL when the build includes DirectX12) copied to shaders\ and flowed to the app. -->
    <KaldraShaderSourceDir>$(MSBuildProjectDirectory)\Shaders</KaldraShaderSourceDir>
    <KaldraShaderOutputMode>Content</KaldraShaderOutputMode>
    <!-- And WGSL, embedded under "BinaryVibrance.Kaldra.UI.Vysara.Shaders.", for an app in the browser: whichever way the app builds,
         this library is the same assembly, so it always carries it -->
    <KaldraEmitWgsl>true</KaldraEmitWgsl>
    <KaldraEmbedWgsl>true</KaldraEmbedWgsl>
    <!-- And the SPIR-V, embedded under the same prefix, for an Android app: an APK has no shader folder, so the Vulkan
         backend reads it from this assembly. The loose copies stay for the desktop. -->
    <KaldraEmbedSpirv>true</KaldraEmbedSpirv>
  </PropertyGroup>

  <PropertyGroup Label="NuGet">
    <PackageId>BinaryVibrance.Kaldra.UI.Vysara</PackageId>
    <Description>Integrates the Vysara retained-mode UI runtime with the Kaldra render graph — bridges the Vysara compositor with Kaldra's backend-neutral draw path.</Description>
    <PackageTags>ui;vysara;rendergraph;gamedev;dotnet</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- The painter's draw-list checks are pinned device-free in BinaryVibrance.Kaldra.Tests, against command streams a compositor
       would never produce. -->
  <ItemGroup>
    <InternalsVisibleTo Include="BinaryVibrance.Kaldra.Tests" />
    <InternalsVisibleTo Include="BinaryVibrance.Kaldra.Gallery.Tests" />
  </ItemGroup>

  <!-- Glue between the standalone Vysara UI runtime and the Kaldra render graph. References both sides;
       neither Vysara nor BinaryVibrance.Kaldra.Core reference each other. -->
  <PropertyGroup>
    <_KaldraNeedsVysaraSource>true</_KaldraNeedsVysaraSource>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(VysaraSource)BinaryVibrance.Vysara\BinaryVibrance.Vysara.csproj" />
    <ProjectReference Include="..\BinaryVibrance.Kaldra.Core\BinaryVibrance.Kaldra.Core.csproj" />
    <ProjectReference Include="..\BinaryVibrance.Kaldra.Assets\BinaryVibrance.Kaldra.Assets.csproj" />
    <ProjectReference Include="..\BinaryVibrance.Kaldra.Input\BinaryVibrance.Kaldra.Input.csproj" />
    <!-- Hermetic slangc for compiling this package's shader (bundled in the package; win-x64 / win-arm64) — build-only. -->
    <PackageReference Include="Slang.Sdk" GeneratePathProperty="true" PrivateAssets="all" ExcludeAssets="compile;runtime" />
    <!-- Hermetic DXC for signing the DXIL output; build-only. -->
    <PackageReference Include="Microsoft.Direct3D.DXC" GeneratePathProperty="true" PrivateAssets="all" ExcludeAssets="compile;runtime" />
  </ItemGroup>

  <Import Project="..\build\BinaryVibrance.Kaldra.Sdk\Kaldra.Shaders.targets" />

</Project>
