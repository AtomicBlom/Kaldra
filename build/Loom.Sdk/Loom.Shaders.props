<Project>

  <!--
    Loom shared shader-compile machinery (Milestone 8) — property defaults.

    Imported by any project that compiles Slang shaders: directly by Loom.Backend.Vulkan (engine shaders, Embed
    mode) and transitively via Sdk.props by an app (Loom.Sandbox, Content mode). Carries NO backend-reference
    logic, so the engine can import it without pulling in (or self-referencing through) the backend selection.

    A consuming project sets:
      <LoomShaderSourceDir>   the folder of *.slang sources
      <LoomShaderOutputMode>  Embed (-> EmbeddedResource, the engine) | Content (-> loose files, an app)
    and adds Slang.Sdk + Microsoft.Direct3D.DXC PackageReferences (both GeneratePathProperty="true")
    for hermetic slangc and hermetic DXC signing respectively.
  -->

  <PropertyGroup>
    <LoomShaderOutputMode Condition="'$(LoomShaderOutputMode)' == ''">None</LoomShaderOutputMode>

    <!-- Also emit SIGNED DXIL beside the SPIR-V (for the DirectX12 backend, which loads the blob — no runtime
         compiler, like the Vulkan .spv). On by default whenever the DirectX12 backend is in the build. Slang's HLSL/
         DXIL target is per-entry-point, so the build emits one signed-DXIL module per stage (vs/ps/cs). -->
    <LoomEmitDxil Condition="'$(LoomEmitDxil)' == '' And '$(UseDirectX12)' == 'true'">true</LoomEmitDxil>
    <LoomEmitDxil Condition="'$(LoomEmitDxil)' == ''">false</LoomEmitDxil>

    <!-- Also emit WGSL beside the SPIR-V (for the WebGPU backend / browser). Unlike DXIL, Slang's WGSL
         target compiles a multi-entry module in one invocation, so one .wgsl per shader. A WGSL-target
         reflection sidecar (<name>.wgsl.json) is emitted too: binding ASSIGNMENTS differ per target
         (WGSL splits each combined Sampler2D into texture+sampler slots and folds the push-constant
         block into an ordinary uniform), so the SPIR-V reflection JSON cannot be reused for layout. -->
    <LoomEmitWgsl Condition="'$(LoomEmitWgsl)' == '' And '$(UseWebGPU)' == 'true'">true</LoomEmitWgsl>
    <LoomEmitWgsl Condition="'$(LoomEmitWgsl)' == ''">false</LoomEmitWgsl>

    <!-- Directory of shared cross-project shader includes (loom_platform.module.slang: the per-target
         LOOM_BINDING / LOOM_PUSH_CONSTANT macros). Passed to every slangc invocation via -I so app and
         UI shader dirs resolve the same header the engine shaders use. In the repo this is Loom.Shaders/Shaders;
         shipped inside the Loom.Sdk package (where that repo path doesn't exist) it's the header packed beside
         this file under Shaders/. -->
    <LoomShaderIncludeDir Condition="'$(LoomShaderIncludeDir)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\Loom.Shaders\Shaders')">$(MSBuildThisFileDirectory)..\..\Loom.Shaders\Shaders</LoomShaderIncludeDir>
    <LoomShaderIncludeDir Condition="'$(LoomShaderIncludeDir)' == ''">$(MSBuildThisFileDirectory)Shaders</LoomShaderIncludeDir>

    <!-- slangc emits DXIL by handing off to DXC, which it loads only from its own module dir or a path we give
         it (NOT the PATH env var). The Microsoft.Direct3D.DXC NuGet package ships architecture-matched
         dxcompiler.dll + dxil.dll; Loom.Shaders.targets picks it up via $(PkgMicrosoft_Direct3D_DXC) when the
         consuming project carries that PackageReference with GeneratePathProperty=true. Falls back to the Windows
         SDK if the package is absent. Override the resolved directory via $(LoomDxcPath). Build-machine only —
         the shipped app carries just the signed .dxil. -->
    <LoomDxcArch Condition="'$(LoomDxcArch)' == '' And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString())' == 'Arm64'">arm64</LoomDxcArch>
    <LoomDxcArch Condition="'$(LoomDxcArch)' == ''">x64</LoomDxcArch>

    <!-- Optional semicolon-separated list of .slang paths/globs to exclude from compilation (on top of the
         always-excluded *.module.slang). Used to drop ImGui's shader when the engine is built without ImGui. -->
    <LoomShaderExclude Condition="'$(LoomShaderExclude)' == ''"></LoomShaderExclude>

    <!-- Config-agnostic (shaders don't vary by Debug/Release) but RID-qualified: a desktop build emits SPIR-V
         (+DXIL) and a browser build emits WGSL, and without separate output dirs the two collide in one obj —
         building one flavor then the other (without a clean) fails reading the other's artifacts. RuntimeIdentifier
         is a global property set early, so this stays timing-independent. Empty RID (desktop) → obj\shaders\;
         browser-wasm → obj\shaders\browser-wasm\. -->
    <LoomShaderOutDir Condition="'$(LoomShaderOutDir)' == ''">$(MSBuildProjectDirectory)\obj\shaders\$(RuntimeIdentifier)\</LoomShaderOutDir>

    <!-- The manifest-name prefix for Embed mode. Defaults to "<AssemblyName>.Shaders." so the runtime can
         derive the same key from its own assembly name (no hardcoded string drift). -->
    <LoomEmbedManifestPrefix Condition="'$(LoomEmbedManifestPrefix)' == ''">$(AssemblyName).Shaders.</LoomEmbedManifestPrefix>

    <!-- slangc RID: win-x64, or win-arm64 on a Snapdragon dev box. (mac/linux acquisition is a later task.)
         Reproduces the original Loom.Shaders.csproj detection verbatim; overridable by setting SlangRid. -->
    <SlangRid Condition="'$(SlangRid)' == '' And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString())' == 'Arm64'">win-arm64</SlangRid>
    <SlangRid Condition="'$(SlangRid)' == ''">win-x64</SlangRid>
  </PropertyGroup>

</Project>
