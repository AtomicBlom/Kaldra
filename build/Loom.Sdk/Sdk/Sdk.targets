<Project>

  <!--
    The app-facing Loom MSBuild SDK (Milestone 8) — targets half. See Sdk.props for usage.

    Pulls in the shared shader-compile machinery (Content mode for an app) and selects which rendering
    backend(s) the app references. Merely referencing a backend assembly loads it, and its [ModuleInitializer]
    self-registers it into Backends.Available — so backend choice is just a ProjectReference toggle.

    Only apps import this file, so a backend reference can never reach Loom.Core/Loom.Graph (the cardinal
    backend-isolation invariant). The guarantee is "absence of import" — no opt-in guard property needed.
  -->

  <!--
    Android, chosen by the target framework (net11.0-android) rather than a RID, and so decided here: a single-target
    project sets its TargetFramework in its body, after Sdk.props. An Android app runs on Vulkan alone, embeds its
    shaders (an APK has no folder beside the app to hold loose ones), and is hosted by Loom.Hosting.Android. Set
    before the shader targets are imported, which read the output mode and the DXIL switch.
  -->
  <PropertyGroup>
    <_LoomTargetsAndroid Condition="'$(TargetFramework)' != '' and '$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'android'">true</_LoomTargetsAndroid>
    <_LoomTargetsAndroid Condition="'$(_LoomTargetsAndroid)' == ''">false</_LoomTargetsAndroid>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_LoomTargetsAndroid)' == 'true'">
    <UseDirectX12>false</UseDirectX12>
    <LoomEmitDxil>false</LoomEmitDxil>
    <LoomShaderOutputMode Condition="'$(_LoomShaderOutputModeDefaulted)' == 'true'">Embed</LoomShaderOutputMode>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\Loom.Shaders.targets" />

  <!--
    Source vs. packaged. In the repo, this file lives at build/Loom.Sdk/Sdk/ and the sibling Loom projects exist
    beside it — so it references them as ProjectReferences. Shipped inside the Loom.Sdk MSBuild-SDK package (and
    resolved via Sdk="Loom.Sdk"), those projects don't exist, so it references the sibling Loom NuGet packages by
    version instead. Detected by whether Loom.Core's csproj is reachable from here.
  -->
  <PropertyGroup>
    <_LoomRepoRoot>$(MSBuildThisFileDirectory)..\..\..\</_LoomRepoRoot>
    <_LoomFromSource Condition="Exists('$(_LoomRepoRoot)Loom.Core\Loom.Core.csproj')">true</_LoomFromSource>
    <!-- Version for sibling Loom package references in packaged mode (matches Version.props / the pack version). -->
    <LoomPackageVersion Condition="'$(LoomPackageVersion)' == ''">0.1.0-preview.1</LoomPackageVersion>
    <!-- slangc version for any consumer that does not take it from the Loom repo's Directory.Packages.props, which
         pins the same version; _LoomCheckSlangVersion below fails the repo's own builds if the two drift apart. -->
    <LoomSlangVersion Condition="'$(LoomSlangVersion)' == ''">0.5.1</LoomSlangVersion>
    <!-- Vysara's package version for packaged mode (BinaryVibrance.Vysara, from Vysara's repository). -->
    <LoomVysaraVersion Condition="'$(LoomVysaraVersion)' == ''">0.1.0-preview.1</LoomVysaraVersion>
  </PropertyGroup>

  <!-- slangc, to compile this app's own shaders. Only the Loom repo's own apps, whose central package management is
       the repo's Directory.Packages.props, take the version from there. Any other consumer gets the pinned version,
       so it needs no Slang reference of its own: as a VersionOverride under central package management of its own
       (a packaged consumer, or a game with Loom as a submodule), where a version-less reference would fail restore
       with NU1010 unless the game listed Slang.Sdk itself, and as a plain Version without it. -->
  <PropertyGroup>
    <_LoomPackageVersionsFile>$([MSBuild]::NormalizePath('$(_LoomRepoRoot)', 'Directory.Packages.props'))</_LoomPackageVersionsFile>
    <_LoomOwnPackageVersions Condition="'$(_LoomFromSource)' == 'true' and '$(ManagePackageVersionsCentrally)' == 'true' and '$(DirectoryPackagesPropsPath)' == '$(_LoomPackageVersionsFile)'">true</_LoomOwnPackageVersions>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Condition="'$(_LoomOwnPackageVersions)' == 'true'" Include="Slang.Sdk" GeneratePathProperty="true" PrivateAssets="all" ExcludeAssets="compile;runtime" />
    <PackageReference Condition="'$(_LoomOwnPackageVersions)' != 'true' and '$(ManagePackageVersionsCentrally)' == 'true'" Include="Slang.Sdk" VersionOverride="$(LoomSlangVersion)" GeneratePathProperty="true" PrivateAssets="all" ExcludeAssets="compile;runtime" />
    <PackageReference Condition="'$(ManagePackageVersionsCentrally)' != 'true'" Include="Slang.Sdk" Version="$(LoomSlangVersion)" GeneratePathProperty="true" PrivateAssets="all" ExcludeAssets="compile;runtime" />
  </ItemGroup>

  <!-- The repo's own builds hold LoomSlangVersion to the Slang.Sdk version in Directory.Packages.props, so a bump to
       one that misses the other fails here rather than giving a packaged consumer a different slangc than Loom's own
       shaders were built with. -->
  <Target Name="_LoomCheckSlangVersion" BeforeTargets="CollectPackageReferences" Condition="'$(_LoomOwnPackageVersions)' == 'true'">
    <ItemGroup>
      <_LoomSlangPackageVersion Include="@(PackageVersion)" Condition="'%(Identity)' == 'Slang.Sdk'" />
    </ItemGroup>
    <Error Condition="'@(_LoomSlangPackageVersion->'%(Version)')' != '$(LoomSlangVersion)'"
           Text="Directory.Packages.props pins Slang.Sdk at '@(_LoomSlangPackageVersion->'%(Version)')', but build/Loom.Sdk/Sdk/Sdk.targets pins LoomSlangVersion at '$(LoomSlangVersion)'. Keep the two the same." />
  </Target>

  <!-- Backends by RID/flags: ProjectReference in the repo, versioned PackageReference when packaged. -->
  <ItemGroup Condition="'$(UseVulkan)' == 'true' and '$(_LoomTargetsBrowser)' != 'true'">
    <ProjectReference Condition="'$(_LoomFromSource)' == 'true'" Include="$(_LoomRepoRoot)Loom.Backend.Vulkan\Loom.Backend.Vulkan.csproj" />
    <PackageReference Condition="'$(_LoomFromSource)' != 'true'" Include="Loom.Backend.Vulkan" Version="$(LoomPackageVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseDirectX12)' == 'true' and '$(_LoomTargetsBrowser)' != 'true'">
    <ProjectReference Condition="'$(_LoomFromSource)' == 'true'" Include="$(_LoomRepoRoot)Loom.Backend.DirectX12\Loom.Backend.DirectX12.csproj" />
    <PackageReference Condition="'$(_LoomFromSource)' != 'true'" Include="Loom.Backend.DirectX12" Version="$(LoomPackageVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseWebGPU)' == 'true'">
    <ProjectReference Condition="'$(_LoomFromSource)' == 'true'" Include="$(_LoomRepoRoot)Loom.Backend.WebGPU\Loom.Backend.WebGPU.csproj" />
    <PackageReference Condition="'$(_LoomFromSource)' != 'true'" Include="Loom.Backend.WebGPU" Version="$(LoomPackageVersion)" />
  </ItemGroup>

  <!-- UI bridges, same shape as the backends. Both reach the GPU only through the neutral draw-list verb, so
       neither drags a UI library into a backend. Vysara brings the XAML runtime transitively (and its generator,
       below); ImGui brings ImGui.NET. -->
  <ItemGroup Condition="'$(UseVysara)' == 'true'">
    <ProjectReference Condition="'$(_LoomFromSource)' == 'true'" Include="$(_LoomRepoRoot)Loom.UI.Vysara\Loom.UI.Vysara.csproj" />
    <PackageReference Condition="'$(_LoomFromSource)' != 'true'" Include="Loom.UI.Vysara" Version="$(LoomPackageVersion)" />
  </ItemGroup>

  <!--
    Vysara's XAML. Turning Vysara on also gives the app Vysara's XAML → typed control-tree generator, so it can
    author .xaml views: every *.xaml under the project (or under VysaraXamlSourceDir) becomes an input the generator
    compiles into its partial x:Class, with XAML errors reported at the .xaml's file and line, and a dotnet watch
    input, so an edit hot-reloads. VysaraXamlEnable=false keeps the runtime without the generator.
    From source this imports Vysara's own build files, which reference the generator project as an analyzer. This
    file is imported after the project body, so UseVysara is already final here. Packaged, the Vysara package carries
    the generator and the same .xaml registration, but a package's analyzers and build files do not flow to an app
    through Loom.UI.Vysara's dependency on it, so the app references the Vysara package itself.
  -->
  <PropertyGroup Condition="'$(UseVysara)' == 'true' and '$(_LoomFromSource)' == 'true'">
    <_LoomNeedsVysaraSource>true</_LoomNeedsVysaraSource>
  </PropertyGroup>
  <Import Project="$(_LoomRepoRoot)build\Vysara.Source.props" Condition="'$(UseVysara)' == 'true' and '$(_LoomFromSource)' == 'true' and '$(_LoomVysaraSourceProps)' != 'true'" />
  <Import Project="$(VysaraSource)build\Vysara.props" Condition="'$(UseVysara)' == 'true' and '$(_LoomFromSource)' == 'true' and Exists('$(VysaraSource)build\Vysara.props')" />
  <Import Project="$(VysaraSource)build\Vysara.targets" Condition="'$(UseVysara)' == 'true' and '$(_LoomFromSource)' == 'true' and Exists('$(VysaraSource)build\Vysara.targets')" />
  <ItemGroup Condition="'$(UseVysara)' == 'true' and '$(_LoomFromSource)' != 'true'">
    <PackageReference Include="BinaryVibrance.Vysara" Version="$(LoomVysaraVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseImGui)' == 'true'">
    <ProjectReference Condition="'$(_LoomFromSource)' == 'true'" Include="$(_LoomRepoRoot)Loom.UI.ImGui\Loom.UI.ImGui.csproj" />
    <PackageReference Condition="'$(_LoomFromSource)' != 'true'" Include="Loom.UI.ImGui" Version="$(LoomPackageVersion)" />
  </ItemGroup>

  <!--
    Application host by RID. The desktop host runs on any non-browser target (it selects whichever desktop
    backend shipped at runtime); the web host runs for browser-wasm. Referencing the host is what makes
    LoomApplication.Run resolve a host (each self-registers via a module initializer), so an app writes only its
    LoomApplication + one LoomApplication.Run(...) line, no platform bootstrap.
  -->
  <ItemGroup Condition="'$(_LoomTargetsBrowser)' != 'true' and '$(_LoomTargetsAndroid)' != 'true' and '$(UseLoomHost)' != 'false'">
    <ProjectReference Condition="'$(_LoomFromSource)' == 'true'" Include="$(_LoomRepoRoot)Loom.Hosting.Desktop\Loom.Hosting.Desktop.csproj" />
    <PackageReference Condition="'$(_LoomFromSource)' != 'true'" Include="Loom.Hosting.Desktop" Version="$(LoomPackageVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(_LoomTargetsAndroid)' == 'true' and '$(UseLoomHost)' != 'false'">
    <ProjectReference Condition="'$(_LoomFromSource)' == 'true'" Include="$(_LoomRepoRoot)Loom.Hosting.Android\Loom.Hosting.Android.csproj" />
    <PackageReference Condition="'$(_LoomFromSource)' != 'true'" Include="Loom.Hosting.Android" Version="$(LoomPackageVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(_LoomTargetsBrowser)' == 'true' and '$(UseWebGPU)' == 'true' and '$(UseLoomHost)' != 'false'">
    <ProjectReference Condition="'$(_LoomFromSource)' == 'true'" Include="$(_LoomRepoRoot)Loom.Hosting.Web\Loom.Hosting.Web.csproj" />
    <PackageReference Condition="'$(_LoomFromSource)' != 'true'" Include="Loom.Hosting.Web" Version="$(LoomPackageVersion)" />
  </ItemGroup>

  <!--
    An app that manages its package versions centrally may not put a Version on a PackageReference (NU1008): the
    packages above take theirs as a VersionOverride there, as Slang.Sdk's does, so the app's Directory.Packages.props
    needn't list them.
  -->
  <ItemGroup Condition="'$(ManagePackageVersionsCentrally)' == 'true' and '$(_LoomFromSource)' != 'true'">
    <PackageReference Update="Loom.Backend.Vulkan;Loom.Backend.DirectX12;Loom.Backend.WebGPU;Loom.UI.Vysara;Loom.UI.ImGui;Loom.Hosting.Desktop;Loom.Hosting.Android;Loom.Hosting.Web;BinaryVibrance.Vysara"
                      VersionOverride="%(Version)" Version="" />
  </ItemGroup>

  <!--
    Game content: the files an app lists as LoomContent, read at run time with LoomApplication.OpenContent by their path
    under the folder the item's wildcard starts from (<LoomContent Include="Content\**" /> makes Content\levels\1.json
    "levels/1.json"). Packed where each host reads it: a content\ folder beside a desktop exe, and the assets of an
    Android APK, which has no folder beside the app. The browser host does not read content yet.
  -->
  <ItemGroup Condition="'$(_LoomTargetsBrowser)' != 'true' and '$(_LoomTargetsAndroid)' != 'true'">
    <Content Include="@(LoomContent)" Link="content\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(_LoomTargetsAndroid)' == 'true'">
    <AndroidAsset Include="@(LoomContent)" Link="Assets\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    Default web shell injection (copy-if-absent): for a browser app that authored no wwwroot/index.html, the web
    host provides a runnable full-screen index.html + main.js at the app's wwwroot root. Imported here for
    source-mode (in-repo) consumers; a packaged consumer gets the same target auto-imported by NuGet from the
    Loom.Hosting.Web package's build/ folder.
  -->
  <Import Project="$(_LoomRepoRoot)Loom.Hosting.Web\build\Loom.Hosting.Web.props"
          Condition="'$(_LoomFromSource)' == 'true' and '$(_LoomTargetsBrowser)' == 'true' and '$(UseWebGPU)' == 'true' and '$(UseLoomHost)' != 'false'" />

  <!--
    Host registration bootstrap. The app names no host type (that's the whole point — it writes only a
    LoomApplication + LoomApplication.Run), so nothing forces the host assembly to load and register. Generate a
    tiny [ModuleInitializer] into the app that registers the selected host: reliable on desktop (JIT), and a
    harmless fast-path on the browser (where LoomApplication.Current is the real mechanism, since WASM-AOT module
    initializers are unreliable). The host type is chosen by the same RID/flags that added the host reference.
  -->
  <PropertyGroup Condition="'$(UseLoomHost)' != 'false'">
    <_LoomHostType Condition="'$(_LoomTargetsBrowser)' == 'true' and '$(UseWebGPU)' == 'true'">Loom.Hosting.Web.WebAppHost</_LoomHostType>
    <_LoomHostType Condition="'$(_LoomTargetsAndroid)' == 'true'">Loom.Hosting.Android.AndroidAppHost</_LoomHostType>
    <_LoomHostType Condition="'$(_LoomTargetsBrowser)' != 'true' and '$(_LoomTargetsAndroid)' != 'true'">Loom.Hosting.Desktop.DesktopAppHost</_LoomHostType>
  </PropertyGroup>

  <Target Name="_LoomGenerateHostBootstrap" BeforeTargets="CoreCompile" Condition="'$(_LoomHostType)' != ''">
    <PropertyGroup>
      <_LoomHostBootstrapFile>$(IntermediateOutputPath)LoomHostBootstrap.g.cs</_LoomHostBootstrapFile>
      <!-- One line; MSBuild-escaped: %3B = ';', %3E = '>'. Registers the SDK-selected host at module init. -->
      <_LoomHostBootstrapCode>namespace Loom.Generated { internal static class LoomHostBootstrap { [System.Runtime.CompilerServices.ModuleInitializer] internal static void Register() =%3E Loom.Core.Hosting.AppHost.Register(new $(_LoomHostType)())%3B } }</_LoomHostBootstrapCode>
    </PropertyGroup>
    <WriteLinesToFile File="$(_LoomHostBootstrapFile)" Lines="$(_LoomHostBootstrapCode)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_LoomHostBootstrapFile)" />
      <FileWrites Include="$(_LoomHostBootstrapFile)" />
    </ItemGroup>
  </Target>

  <!--
    Backend registration bootstrap. Referencing a backend assembly makes its module initializer run under JIT
    (first type touch triggers it lazily), but a NativeAOT-published app may never touch a backend type directly —
    it only ever sees Backends.Available through the host — so nothing forces the constructor to run and the
    backend never registers. Generate a tiny [ModuleInitializer] into the app that forces each SELECTED backend's
    module constructor via a compile-time typeof (no Assembly.LoadFrom, so this stays AOT-safe: no reflection-emit,
    no probing the output directory). Each backend's own module initializer still runs its IsSupported() probe
    before registering, so forcing it here doesn't bypass that gate — an unsupported backend still won't register.
  -->
  <PropertyGroup>
    <_LoomBackendBootstrapCalls Condition="'$(UseVulkan)' == 'true' and '$(_LoomTargetsBrowser)' != 'true'">$(_LoomBackendBootstrapCalls)System.Runtime.CompilerServices.RuntimeHelpers.RunModuleConstructor(typeof(Loom.Backend.Vulkan.VulkanBackend).Module.ModuleHandle)%3B </_LoomBackendBootstrapCalls>
    <_LoomBackendBootstrapCalls Condition="'$(UseDirectX12)' == 'true' and '$(_LoomTargetsBrowser)' != 'true'">$(_LoomBackendBootstrapCalls)System.Runtime.CompilerServices.RuntimeHelpers.RunModuleConstructor(typeof(Loom.Backend.DirectX12.DirectX12Backend).Module.ModuleHandle)%3B </_LoomBackendBootstrapCalls>
    <_LoomBackendBootstrapCalls Condition="'$(UseWebGPU)' == 'true'">$(_LoomBackendBootstrapCalls)System.Runtime.CompilerServices.RuntimeHelpers.RunModuleConstructor(typeof(Loom.Backend.WebGPU.WebGpuBackend).Module.ModuleHandle)%3B </_LoomBackendBootstrapCalls>
  </PropertyGroup>

  <Target Name="_LoomGenerateBackendBootstrap" BeforeTargets="CoreCompile" Condition="'$(_LoomBackendBootstrapCalls)' != ''">
    <PropertyGroup>
      <_LoomBackendBootstrapFile>$(IntermediateOutputPath)LoomBackendBootstrap.g.cs</_LoomBackendBootstrapFile>
      <!-- MSBuild-escaped: %3B = ';'. Forces every selected backend's module constructor at app module init. -->
      <_LoomBackendBootstrapCode>namespace Loom.Generated { internal static class LoomBackendBootstrap { [System.Runtime.CompilerServices.ModuleInitializer] internal static void Register() { $(_LoomBackendBootstrapCalls) } } }</_LoomBackendBootstrapCode>
    </PropertyGroup>
    <WriteLinesToFile File="$(_LoomBackendBootstrapFile)" Lines="$(_LoomBackendBootstrapCode)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_LoomBackendBootstrapFile)" />
      <FileWrites Include="$(_LoomBackendBootstrapFile)" />
    </ItemGroup>
  </Target>

  <!--
    Close out the RID-conditional base-SDK delegation started in Sdk.props (same guard properties, still in
    scope — MSBuild properties persist across one project's whole evaluation). For the traditional
    fixed-outer-Sdk usage (e.g. the gallery's Loom.Sandbox) both imports are skipped: the outer Sdk="Microsoft.NET.Sdk"
    already resolved Microsoft.NET.Sdk's real targets, which MSBuild auto-imports last regardless, so nothing
    here would run anyway. For the bare-<Project> usage this is the only place the real base SDK's targets get
    imported at all, since there's no outer Sdk to do it implicitly.
  -->
  <Import Sdk="Microsoft.NET.Sdk.WebAssembly" Project="Sdk.targets" Condition="'$(_LoomTargetsBrowser)' == 'true' and '$(_LoomSdkImportsWebAssembly)' == 'true'" />
  <Import Sdk="Microsoft.NET.Sdk" Project="Sdk.targets" Condition="'$(_LoomTargetsBrowser)' != 'true' and '$(_LoomSdkImportsNetSdk)' == 'true'" />

</Project>
