<Project>

  <!--
    Loom shared shader-compile machinery (Milestone 8) — targets.

    Imported AFTER the project body (so $(LoomShaderSourceDir) is already set). Compiles *.slang -> SPIR-V
    (+ a reflection-JSON sidecar) hermetically via the slangc bundled in Slang.Sdk, then registers the
    outputs in one of two modes:
      Content -> loose <Content> copied to the output under shaders\  (an app, e.g. Loom.Sandbox)
      Embed   -> <EmbeddedResource> with a stable manifest name        (the engine, Loom.Backend.Vulkan)

    When $(LoomEmitHlsl) is set (the DirectX12 backend is in the build) it ALSO emits per-stage HLSL beside the
    SPIR-V — <name>.vs.hlsl / <name>.ps.hlsl / <name>.cs.hlsl. Slang's HLSL target is per-entry-point (a
    combined multi-entry module duplicates the shared structs and won't compile), so each stage is emitted
    on its own; the stages are the fixed vs/fragment/compute set, so no per-shader entry enumeration is
    needed. The DirectX12 backend resolves the stage files it needs and compiles each.
  -->

  <PropertyGroup>
    <SlangCompiler Condition="'$(SlangCompiler)' == ''">$(PkgSlang_Sdk)\runtimes\$(SlangRid)\native\slangc.exe</SlangCompiler>
  </PropertyGroup>

  <!-- Top-level (evaluated when LoomShaderSourceDir is known). Entry shaders compile standalone;
       *.module.slang are shared imports (tracked for incremental, never compiled on their own). The glob is
       over SOURCE .slang (which exist at evaluation); the .spv/.json are referenced only as transforms. -->
  <!-- Per-shader entry-point names, defaulting to the conventional ones every shader in this repo uses. A project
       overrides one per shader with item metadata:

         <ItemGroup>
           <LoomSlangEntry Update="Shaders\reduce.slang" ComputeEntry="reduceMain" />
         </ItemGroup>

       That ItemGroup MUST come AFTER this file is imported — the glob below is what creates the items an Update
       attaches to, and an Update naming an item that does not exist yet is silently ignored. These defaults are an
       ItemDefinitionGroup rather than conditional metadata so an explicit value on the item always wins. -->
  <ItemDefinitionGroup Condition="'$(LoomShaderOutputMode)' != 'None'">
    <LoomSlangEntry>
      <VertexEntry>vertexMain</VertexEntry>
      <FragmentEntry>fragmentMain</FragmentEntry>
      <ComputeEntry>computeMain</ComputeEntry>
      <Stages></Stages>
    </LoomSlangEntry>
  </ItemDefinitionGroup>

  <!-- An app with no shaders of its own (no LoomShaderSourceDir: it draws with a library's) compiles nothing; an empty
       directory would make these globs search the drive root. -->
  <ItemGroup Condition="'$(LoomShaderOutputMode)' != 'None' and '$(LoomShaderSourceDir)' != ''">
    <LoomSlangEntry  Include="$(LoomShaderSourceDir)\**\*.slang" Exclude="$(LoomShaderSourceDir)\**\*.module.slang;$(LoomShaderExclude)" />
    <LoomSlangModule Include="$(LoomShaderSourceDir)\**\*.module.slang" />
    <!-- Shared includes (the LOOM_BINDING/LOOM_PUSH_CONSTANT header) live outside app shader dirs;
         track them as modules so editing one rebuilds every dependent shader. Duplicates (when the
         source dir IS the include dir, i.e. the engine) are harmless in an Inputs list. -->
    <LoomSlangModule Include="$(LoomShaderIncludeDir)\*.module.slang" Condition="Exists('$(LoomShaderIncludeDir)')" />
    <LoomSlangSource Include="@(LoomSlangEntry);@(LoomSlangModule)" />

    <!-- Keep the IDE FastUpToDateCheck aware of shader inputs/outputs so it never skips a build and runs
         stale SPIR-V (the classic "my shader edit did nothing" trap) — applies to embedded resources too. -->
    <UpToDateCheckInput Include="@(LoomSlangSource)" />
    <UpToDateCheckBuilt Include="@(LoomSlangEntry->'$(LoomShaderOutDir)%(Filename).spv')" />
    <UpToDateCheckBuilt Include="@(LoomSlangEntry->'$(LoomShaderOutDir)%(Filename).json')" />
    <UpToDateCheckBuilt Include="@(LoomSlangEntry->'$(LoomShaderOutDir)%(Filename).wgsl')" Condition="'$(LoomEmitWgsl)' == 'true'" />
    <UpToDateCheckBuilt Include="@(LoomSlangEntry->'$(LoomShaderOutDir)%(Filename).wgsl.json')" Condition="'$(LoomEmitWgsl)' == 'true'" />

    <!-- What the compile must have produced for it to count as up to date: the SPIR-V, and the WGSL when it is
         emitted. With the SPIR-V alone, an output folder that already held another build's SPIR-V (a desktop build
         of the same project) skipped the compile, and the WGSL was never made. -->
    <_LoomShaderOutput Include="@(LoomSlangEntry->'$(LoomShaderOutDir)%(Filename).spv')" />
    <_LoomShaderOutput Include="@(LoomSlangEntry->'$(LoomShaderOutDir)%(Filename).wgsl')" Condition="'$(LoomEmitWgsl)' == 'true'" />
  </ItemGroup>

  <!-- An item's own Stages (see the DXIL emit below), normalised and checked before anything compiles: tokens are
       trimmed and lower-cased ("Vertex; fragment" is "vertex;fragment"), and any token that is not vertex, fragment or
       compute, or a Stages that names none, fails the build. Dropping an unknown token ("pixel") instead would build a
       shader with no fragment DXIL, which DirectX 12 finds missing only at run time. Runs ahead of the compile's
       up-to-date check, so a bad Stages fails even a build with nothing to compile, and so the DXIL an item's Stages
       promises is among the outputs that check looks for: adding Stages to an item whose SPIR-V is already up to date
       then compiles it, rather than leaving its DXIL unmade. -->
  <Target Name="_LoomResolveShaderStages" Condition="'$(LoomShaderOutputMode)' != 'None'">
    <ItemGroup>
      <LoomSlangEntry Condition="'%(LoomSlangEntry.Stages)' != ''">
        <_StagesGiven>%(LoomSlangEntry.Stages)</_StagesGiven>
        <Stages>$([System.Text.RegularExpressions.Regex]::Replace($([System.Text.RegularExpressions.Regex]::Replace('%(LoomSlangEntry.Stages)', '\s*;\s*', ';').Trim().ToLowerInvariant()), ';+', ';').Trim(';'))</Stages>
      </LoomSlangEntry>
      <LoomSlangEntry Condition="'%(LoomSlangEntry._StagesGiven)' != ''">
        <_StagesValid>$([System.Text.RegularExpressions.Regex]::IsMatch('%(LoomSlangEntry.Stages)', '^(vertex|fragment|compute)(;(vertex|fragment|compute))*$'))</_StagesValid>
      </LoomSlangEntry>
    </ItemGroup>
    <Error Condition="'%(LoomSlangEntry._StagesGiven)' != '' And '%(LoomSlangEntry._StagesValid)' != 'True'"
           Text="%(LoomSlangEntry.Filename).slang has Stages=&quot;%(LoomSlangEntry._StagesGiven)&quot;, but Stages is a semicolon-separated list of one or more of vertex, fragment and compute." />
    <ItemGroup Condition="'$(LoomEmitDxil)' == 'true'">
      <_LoomShaderOutput Include="@(LoomSlangEntry->'$(LoomShaderOutDir)%(Filename).vs.dxil')" Condition="$([System.String]::Copy(';%(LoomSlangEntry.Stages);').Contains(';vertex;'))" />
      <_LoomShaderOutput Include="@(LoomSlangEntry->'$(LoomShaderOutDir)%(Filename).ps.dxil')" Condition="$([System.String]::Copy(';%(LoomSlangEntry.Stages);').Contains(';fragment;'))" />
      <_LoomShaderOutput Include="@(LoomSlangEntry->'$(LoomShaderOutDir)%(Filename).cs.dxil')" Condition="$([System.String]::Copy(';%(LoomSlangEntry.Stages);').Contains(';compute;'))" />
    </ItemGroup>
  </Target>

  <!-- Incremental: recompile when ANY .slang (entry OR shared module) is newer than ANY .spv. Listing every
       source as an input means editing a shared *.module.slang rebuilds the shaders that import it. The project file
       is an input too, since the items' metadata (Stages, an entry point's name) is written there and changes what
       the compile emits. -->
  <Target Name="LoomCompileShaders"
          Condition="'$(LoomShaderOutputMode)' != 'None'"
          DependsOnTargets="_LoomResolveShaderStages"
          Inputs="@(LoomSlangSource);$(MSBuildProjectFullPath)"
          Outputs="@(_LoomShaderOutput)">
    <Error Condition="'$(PkgSlang_Sdk)' == ''"
           Text="LoomShaderOutputMode='$(LoomShaderOutputMode)' but Slang.Sdk is not referenced in this project. Add a Slang.Sdk PackageReference with GeneratePathProperty=&quot;true&quot;." />
    <Error Condition="!Exists('$(SlangCompiler)')"
           Text="slangc not found at '$(SlangCompiler)'. Is Slang.Sdk restored for RID '$(SlangRid)'? (Only win-x64 / win-arm64 are packaged.)" />
    <MakeDir Directories="$(LoomShaderOutDir)" />
    <Message Importance="high" Text="Slang -&gt; SPIR-V (+reflection): %(LoomSlangEntry.Filename).slang" />
    <!-- Emit reflection JSON beside the SPIR-V (M7-B4): the backend reads it at DefineTechnique to derive
         the descriptor-binding layout, so the app states only pipeline intent. -->
    <Exec Command="&quot;$(SlangCompiler)&quot; &quot;%(LoomSlangEntry.FullPath)&quot; -target spirv -I &quot;$(LoomShaderIncludeDir)&quot; -o &quot;$(LoomShaderOutDir)%(LoomSlangEntry.Filename).spv&quot; -reflection-json &quot;$(LoomShaderOutDir)%(LoomSlangEntry.Filename).json&quot;" />

    <!-- DirectX12: also emit SIGNED DXIL here (same target as SPIR-V, so the single LoomCompileShaders dependency
         covers BOTH and the registration below always sees every produced stage — a separate emit target
         ordered before/after caused register to snapshot mid-emit and miss .ps/.cs). Resolve the architecture-
         matched Windows SDK dxc dir for slangc's -dxc-path (forward slashes so a trailing "\" doesn't escape the
         quote in cmd). One Exec per stage, run ONLY for the entry points the shader actually declares
         (detected from its source). A missing stage is skipped — no error to swallow — and a stage that IS
         declared but fails to compile to DXIL HARD-FAILS the build, instead of being silently dropped and
         leaving DirectX12 to fall back to a stand-in (the exact cross-backend break this layer guards against). -->
    <!-- DXC resolution: hermetic NuGet package first ($(PkgMicrosoft_Direct3D_DXC) set via GeneratePathProperty
         on a Microsoft.Direct3D.DXC PackageReference), then Windows SDK as a fallback for machines where the
         package is not referenced. Forward-slashes: a trailing backslash escapes the closing quote in cmd. -->
    <PropertyGroup Condition="'$(LoomEmitDxil)' == 'true' And '$(LoomDxcPath)' == '' And '$(PkgMicrosoft_Direct3D_DXC)' != ''">
      <LoomDxcPath>$(PkgMicrosoft_Direct3D_DXC)\build\native\bin\$(LoomDxcArch)</LoomDxcPath>
      <LoomDxcPath>$(LoomDxcPath.Replace('\','/'))</LoomDxcPath>
    </PropertyGroup>
    <ItemGroup Condition="'$(LoomEmitDxil)' == 'true' And '$(LoomDxcPath)' == ''">
      <_LoomDxcDll Include="$(MSBuildProgramFiles32)\Windows Kits\10\bin\**\$(LoomDxcArch)\dxcompiler.dll" />
    </ItemGroup>
    <PropertyGroup Condition="'$(LoomEmitDxil)' == 'true' And '$(LoomDxcPath)' == ''">
      <LoomDxcPath>@(_LoomDxcDll->'%(RootDir)%(Directory)'->Distinct())</LoomDxcPath>
      <LoomDxcPath>$(LoomDxcPath.Replace('\','/'))</LoomDxcPath>
    </PropertyGroup>
    <Warning Condition="'$(LoomEmitDxil)' == 'true' And '$(LoomDxcPath)' == ''"
             Text="LoomEmitDxil is on but no DXC found (neither Microsoft.Direct3D.DXC NuGet package nor Windows SDK '$(LoomDxcArch)' bin). Add a Microsoft.Direct3D.DXC PackageReference with GeneratePathProperty=true to this project, or set $(LoomDxcPath)." />
    <Message Condition="'$(LoomEmitDxil)' == 'true'" Importance="high" Text="Slang -&gt; signed DXIL (per stage): %(LoomSlangEntry.Filename).slang" />
    <!-- Which stages to emit comes from the [shader("...")] attributes the source declares, and the entry-point name
         for each comes from item metadata defaulting to the conventional name. Matching the attribute rather than
         searching for the entry name keeps a mention in a comment (or a substring of another identifier) from
         requesting a stage the module has no entry for. The file text is passed as a nested property-function result,
         never embedded in the expression, so quotes/parens/semicolons in the shader cannot break argument parsing.

         The scan is per-file and does not follow #include, so a stage declared in an imported module is invisible
         here. That is caught by the entry-presence check below rather than silently dropping the stage, unless the
         item names its stages itself (Stages, below). -->
    <ItemGroup Condition="'$(LoomEmitDxil)' == 'true'">
      <!-- VertexEntry/FragmentEntry/ComputeEntry ride along from LoomSlangEntry (the ItemDefinitionGroup default,
           or a per-shader override) — a transform copies the source item's metadata. -->
      <_LoomDxilEntry Include="@(LoomSlangEntry)">
        <HasVertex>$([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('%(FullPath)')), '\[\s*shader\s*\(\s*"vertex"\s*\)\s*\]'))</HasVertex>
        <HasFragment>$([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('%(FullPath)')), '\[\s*shader\s*\(\s*"fragment"\s*\)\s*\]'))</HasFragment>
        <HasCompute>$([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('%(FullPath)')), '\[\s*shader\s*\(\s*"compute"\s*\)\s*\]'))</HasCompute>
      </_LoomDxilEntry>
      <!-- A declared stage whose named entry function is absent would compile to nothing, leaving DirectX 12 to fail
           at technique registration with a missing-artifact error far from the cause. Detect it here instead. -->
      <_LoomDxilEntry>
        <VertexOk>$([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('%(FullPath)')), '\b%(VertexEntry)\s*\('))</VertexOk>
        <FragmentOk>$([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('%(FullPath)')), '\b%(FragmentEntry)\s*\('))</FragmentOk>
        <ComputeOk>$([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('%(FullPath)')), '\b%(ComputeEntry)\s*\('))</ComputeOk>
      </_LoomDxilEntry>
      <!-- A shader whose entry points come from an #include (one source compiled twice, a variant defining a macro and
           including the other) declares its stages on the item, since the scan above can't see them:
             <LoomSlangEntry Update="Shaders\*_cast.slang" Stages="vertex;fragment" />
           Its entry functions are then taken on trust; slangc fails the compile if one is missing. Its Stages arrive
           here checked and normalised by _LoomResolveShaderStages. -->
      <_LoomDxilEntry Condition="'%(_LoomDxilEntry.Stages)' != ''">
        <HasVertex>$([System.String]::Copy(';%(_LoomDxilEntry.Stages);').Contains(';vertex;'))</HasVertex>
        <HasFragment>$([System.String]::Copy(';%(_LoomDxilEntry.Stages);').Contains(';fragment;'))</HasFragment>
        <HasCompute>$([System.String]::Copy(';%(_LoomDxilEntry.Stages);').Contains(';compute;'))</HasCompute>
        <VertexOk>True</VertexOk>
        <FragmentOk>True</FragmentOk>
        <ComputeOk>True</ComputeOk>
      </_LoomDxilEntry>
    </ItemGroup>
    <Error Condition="'$(LoomEmitDxil)' == 'true' And '%(_LoomDxilEntry.HasVertex)' == 'True' And '%(_LoomDxilEntry.VertexOk)' != 'True'" Text="%(_LoomDxilEntry.Filename).slang declares a [shader(&quot;vertex&quot;)] entry point, but no function named '%(_LoomDxilEntry.VertexEntry)' is defined in that file. Rename the function, or name the entry on the item: &lt;LoomSlangEntry Update=&quot;%(_LoomDxilEntry.Identity)&quot; VertexEntry=&quot;yourEntry&quot; /&gt;." />
    <Error Condition="'$(LoomEmitDxil)' == 'true' And '%(_LoomDxilEntry.HasFragment)' == 'True' And '%(_LoomDxilEntry.FragmentOk)' != 'True'" Text="%(_LoomDxilEntry.Filename).slang declares a [shader(&quot;fragment&quot;)] entry point, but no function named '%(_LoomDxilEntry.FragmentEntry)' is defined in that file. Rename the function, or name the entry on the item: &lt;LoomSlangEntry Update=&quot;%(_LoomDxilEntry.Identity)&quot; FragmentEntry=&quot;yourEntry&quot; /&gt;." />
    <Error Condition="'$(LoomEmitDxil)' == 'true' And '%(_LoomDxilEntry.HasCompute)' == 'True' And '%(_LoomDxilEntry.ComputeOk)' != 'True'" Text="%(_LoomDxilEntry.Filename).slang declares a [shader(&quot;compute&quot;)] entry point, but no function named '%(_LoomDxilEntry.ComputeEntry)' is defined in that file. Rename the function, or name the entry on the item: &lt;LoomSlangEntry Update=&quot;%(_LoomDxilEntry.Identity)&quot; ComputeEntry=&quot;yourEntry&quot; /&gt;." />
    <Exec Condition="'$(LoomEmitDxil)' == 'true' And '%(_LoomDxilEntry.HasVertex)' == 'True'" Command="&quot;$(SlangCompiler)&quot; &quot;%(_LoomDxilEntry.FullPath)&quot; -target dxil -profile sm_6_0 -dxc-path &quot;$(LoomDxcPath)&quot; -I &quot;$(LoomShaderIncludeDir)&quot; -entry %(_LoomDxilEntry.VertexEntry) -stage vertex -o &quot;$(LoomShaderOutDir)%(_LoomDxilEntry.Filename).vs.dxil&quot;" />
    <Exec Condition="'$(LoomEmitDxil)' == 'true' And '%(_LoomDxilEntry.HasFragment)' == 'True'" Command="&quot;$(SlangCompiler)&quot; &quot;%(_LoomDxilEntry.FullPath)&quot; -target dxil -profile sm_6_0 -dxc-path &quot;$(LoomDxcPath)&quot; -I &quot;$(LoomShaderIncludeDir)&quot; -entry %(_LoomDxilEntry.FragmentEntry) -stage fragment -o &quot;$(LoomShaderOutDir)%(_LoomDxilEntry.Filename).ps.dxil&quot;" />
    <Exec Condition="'$(LoomEmitDxil)' == 'true' And '%(_LoomDxilEntry.HasCompute)' == 'True'" Command="&quot;$(SlangCompiler)&quot; &quot;%(_LoomDxilEntry.FullPath)&quot; -target dxil -profile sm_6_0 -dxc-path &quot;$(LoomDxcPath)&quot; -I &quot;$(LoomShaderIncludeDir)&quot; -entry %(_LoomDxilEntry.ComputeEntry) -stage compute -o &quot;$(LoomShaderOutDir)%(_LoomDxilEntry.Filename).cs.dxil&quot;" />

    <!-- WebGPU: also emit WGSL (whole module — Slang's WGSL target handles multi-entry) plus the
         WGSL-target reflection sidecar. -DLOOM_WGSL flips the loom_platform.module.slang macros: explicit
         [[vk::binding]] slots are dropped (Slang auto-assigns unique WGSL bindings in declaration order —
         explicit Vulkan numbers would collide because a combined Sampler2D needs TWO slots) and the
         push-constant block lowers to an ordinary uniform. The WebGPU backend derives its bind-group
         layouts from the emitted WGSL text + this sidecar, never from the Vulkan slot scheme. -->
    <Message Condition="'$(LoomEmitWgsl)' == 'true'" Importance="high" Text="Slang -&gt; WGSL (+reflection): %(LoomSlangEntry.Filename).slang" />
    <Exec Condition="'$(LoomEmitWgsl)' == 'true'" Command="&quot;$(SlangCompiler)&quot; &quot;%(LoomSlangEntry.FullPath)&quot; -target wgsl -DLOOM_WGSL -I &quot;$(LoomShaderIncludeDir)&quot; -o &quot;$(LoomShaderOutDir)%(LoomSlangEntry.Filename).wgsl&quot; -reflection-json &quot;$(LoomShaderOutDir)%(LoomSlangEntry.Filename).wgsl.json&quot;" />
  </Target>

  <!-- No Inputs/Outputs => ALWAYS runs (even when the compile targets are up to date), so the outputs are
       always registered and never silently dropped from the assembly/output on incremental builds. The
       EmbeddedResource/Content items are added HERE (in a target), not in a top-level ItemGroup, because at
       evaluation time the .spv/.hlsl don't exist yet — a static glob over obj\shaders\ would embed nothing.

       Anchor: BeforeTargets="AssignTargetPaths" for BOTH modes. AssignTargetPaths runs before the resource
       pipeline (SplitResourcesByCulture -> CreateManifestResourceNames) and before Content target-path
       assignment, so items added here flow to Csc (Embed) / to the output (Content). Anchoring at
       BeforeCompile/CoreCompile is TOO LATE for EmbeddedResource — CreateManifestResourceNames has already
       snapshotted @(EmbeddedResource) by then, so the late items never reach the compiler. -->
  <Target Name="LoomRegisterShaders"
          Condition="'$(LoomShaderOutputMode)' != 'None'"
          DependsOnTargets="LoomCompileShaders"
          BeforeTargets="AssignTargetPaths">

    <!-- The per-stage signed-DXIL files actually produced. Enumerated via a Directory.GetFiles property function,
         NOT a "$(LoomShaderOutDir)*.dxil" wildcard Include: MSBuild caches a wildcard item's evaluation (it can
         snapshot a stale/partial directory and miss stages), whereas the property function reads the filesystem
         fresh here — after LoomCompileShaders (via DependsOnTargets) has emitted every stage. -->
    <ItemGroup Condition="'$(LoomEmitDxil)' == 'true'">
      <LoomDxilFile Include="$([System.IO.Directory]::GetFiles('$(LoomShaderOutDir)', '*.dxil'))" />
    </ItemGroup>

    <!-- Content (app/UI package): loose .spv/.json (+ signed DXIL) copied to shaders\ in the project output,
         flowing via P2P project references to consuming app's bin.

         PackagePath is set so NuGet packs each file into contentFiles/any/any/shaders/ — the explicit
         PackagePath overrides NuGet's default path calculation (which would otherwise use the obj\shaders\
         relative path as the target). PackageCopyToOutput=true maps to copyToOutput="true" in the nuspec
         <contentFiles> section so the files are copied to a consuming project's output at restore time.

         Do NOT add Pack=false here: that would add the files to _PackageFilesToExclude, which blacklists
         them from appearing in the package even when re-added via other item groups. -->
    <ItemGroup Condition="'$(LoomShaderOutputMode)' == 'Content'">
      <Content Include="@(LoomSlangEntry->'$(LoomShaderOutDir)%(Filename).spv')">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <Link>shaders\%(Filename).spv</Link>
        <PackagePath>contentFiles/any/any/shaders/%(Filename).spv</PackagePath>
        <PackageCopyToOutput>true</PackageCopyToOutput>
        <Visible>false</Visible>
      </Content>
      <Content Include="@(LoomSlangEntry->'$(LoomShaderOutDir)%(Filename).json')">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <Link>shaders\%(Filename).json</Link>
        <PackagePath>contentFiles/any/any/shaders/%(Filename).json</PackagePath>
        <PackageCopyToOutput>true</PackageCopyToOutput>
        <Visible>false</Visible>
      </Content>
      <Content Include="@(LoomDxilFile)">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <Link>shaders\%(Filename)%(Extension)</Link>
        <PackagePath>contentFiles/any/any/shaders/%(Filename)%(Extension)</PackagePath>
        <PackageCopyToOutput>true</PackageCopyToOutput>
        <Visible>false</Visible>
      </Content>
      <Content Include="@(LoomSlangEntry->'$(LoomShaderOutDir)%(Filename).wgsl')" Condition="'$(LoomEmitWgsl)' == 'true' and '$(LoomEmbedWgsl)' != 'true'">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <Link>shaders\%(Filename).wgsl</Link>
        <PackagePath>contentFiles/any/any/shaders/%(Filename).wgsl</PackagePath>
        <PackageCopyToOutput>true</PackageCopyToOutput>
        <Visible>false</Visible>
      </Content>
      <Content Include="@(LoomSlangEntry->'$(LoomShaderOutDir)%(Filename).wgsl.json')" Condition="'$(LoomEmitWgsl)' == 'true' and '$(LoomEmbedWgsl)' != 'true'">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <Link>shaders\%(Filename).wgsl.json</Link>
        <PackagePath>contentFiles/any/any/shaders/%(Filename).wgsl.json</PackagePath>
        <PackageCopyToOutput>true</PackageCopyToOutput>
        <Visible>false</Visible>
      </Content>
    </ItemGroup>

    <!-- Content with LoomEmbedWgsl (a library's shaders, as Loom.UI.SUIsei's): the WGSL is embedded while the rest stay
         loose, because a browser app has no shader folder to look in. The web host finds it by the library's
         "<AssemblyName>.Shaders." prefix. -->
    <ItemGroup Condition="'$(LoomShaderOutputMode)' == 'Content' and '$(LoomEmitWgsl)' == 'true' and '$(LoomEmbedWgsl)' == 'true'">
      <EmbeddedResource Include="@(LoomSlangEntry->'$(LoomShaderOutDir)%(Filename).wgsl')">
        <LogicalName>$(LoomEmbedManifestPrefix)%(Filename).wgsl</LogicalName>
        <WithCulture>false</WithCulture>
        <Visible>false</Visible>
      </EmbeddedResource>
      <EmbeddedResource Include="@(LoomSlangEntry->'$(LoomShaderOutDir)%(Filename).wgsl.json')">
        <LogicalName>$(LoomEmbedManifestPrefix)%(Filename).wgsl.json</LogicalName>
        <WithCulture>false</WithCulture>
        <Visible>false</Visible>
      </EmbeddedResource>
    </ItemGroup>

    <!-- Content with LoomEmbedSpirv (a library's shaders, as Loom.UI.SUIsei's): the SPIR-V and its reflection JSON are
         embedded as well as copied loose, because an Android app has no shader folder beside it either; the loose
         copies keep the desktop's shader folder and hot reload as they were. The Vulkan backend's ShaderResolver finds
         them by the library's "<AssemblyName>.Shaders." prefix. -->
    <ItemGroup Condition="'$(LoomShaderOutputMode)' == 'Content' and '$(LoomEmbedSpirv)' == 'true'">
      <EmbeddedResource Include="@(LoomSlangEntry->'$(LoomShaderOutDir)%(Filename).spv')">
        <LogicalName>$(LoomEmbedManifestPrefix)%(Filename).spv</LogicalName>
        <WithCulture>false</WithCulture>
        <Visible>false</Visible>
      </EmbeddedResource>
      <EmbeddedResource Include="@(LoomSlangEntry->'$(LoomShaderOutDir)%(Filename).json')">
        <LogicalName>$(LoomEmbedManifestPrefix)%(Filename).json</LogicalName>
        <WithCulture>false</WithCulture>
        <Visible>false</Visible>
      </EmbeddedResource>
    </ItemGroup>

    <!-- Embed (engine): .spv/.json (+ HLSL) become EmbeddedResource with a STABLE flat manifest name the engine
         reads via Assembly.GetManifestResourceStream("<prefix><name>.spv"). The LogicalName is mandatory:
         without it MSBuild derives the name from the obj\shaders\ path (ugly + build-config-dependent). -->
    <ItemGroup Condition="'$(LoomShaderOutputMode)' == 'Embed'">
      <EmbeddedResource Include="@(LoomSlangEntry->'$(LoomShaderOutDir)%(Filename).spv')">
        <LogicalName>$(LoomEmbedManifestPrefix)%(Filename).spv</LogicalName>
        <Visible>false</Visible>
      </EmbeddedResource>
      <EmbeddedResource Include="@(LoomSlangEntry->'$(LoomShaderOutDir)%(Filename).json')">
        <LogicalName>$(LoomEmbedManifestPrefix)%(Filename).json</LogicalName>
        <Visible>false</Visible>
      </EmbeddedResource>
      <!-- WithCulture=false is REQUIRED: a stage suffix like ".ps"/".cs" (blit.ps.dxil, exposure.cs.dxil) is a
           valid culture code (Pashto / Czech), so MSBuild's AssignCulture would otherwise treat the file as a
           satellite-assembly resource and drop it from the main manifest — leaving only ".vs" (not a culture). -->
      <EmbeddedResource Include="@(LoomDxilFile)">
        <LogicalName>$(LoomEmbedManifestPrefix)%(Filename)%(Extension)</LogicalName>
        <WithCulture>false</WithCulture>
        <Visible>false</Visible>
      </EmbeddedResource>
      <EmbeddedResource Include="@(LoomSlangEntry->'$(LoomShaderOutDir)%(Filename).wgsl')" Condition="'$(LoomEmitWgsl)' == 'true'">
        <LogicalName>$(LoomEmbedManifestPrefix)%(Filename).wgsl</LogicalName>
        <WithCulture>false</WithCulture>
        <Visible>false</Visible>
      </EmbeddedResource>
      <EmbeddedResource Include="@(LoomSlangEntry->'$(LoomShaderOutDir)%(Filename).wgsl.json')" Condition="'$(LoomEmitWgsl)' == 'true'">
        <LogicalName>$(LoomEmbedManifestPrefix)%(Filename).wgsl.json</LogicalName>
        <WithCulture>false</WithCulture>
        <Visible>false</Visible>
      </EmbeddedResource>
    </ItemGroup>
  </Target>


</Project>
