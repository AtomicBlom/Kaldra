<Project>

  <!--
    Loom shared shader-compile machinery (Milestone 8) — targets.

    Imported AFTER the project body (so $(LoomShaderSourceDir) is already set). Compiles *.slang -> SPIR-V
    (+ a reflection-JSON sidecar) hermetically via the slangc bundled in Slang.Sdk, then registers the
    outputs in one of two modes:
      Content -> loose <Content> copied to the output under shaders\  (an app, e.g. Loom.Sandbox)
      Embed   -> <EmbeddedResource> with a stable manifest name        (the engine, Loom.Vulkan)

    When $(LoomEmitHlsl) is set (the DirectX12 backend is in the build) it ALSO emits per-stage HLSL beside the
    SPIR-V — <name>.vs.hlsl / <name>.ps.hlsl / <name>.cs.hlsl. Slang's HLSL target is per-entry-point (a
    combined multi-entry module duplicates the shared structs and won't compile), so each stage is emitted
    on its own; the stages are the fixed vs/fragment/compute set, so no per-shader entry enumeration is
    needed. The DirectX12 backend resolves the stage files it needs and compiles each.
  -->

  <PropertyGroup>
    <SlangCompiler Condition="'$(SlangCompiler)' == ''">$(PkgSlang_Sdk)\runtimes\$(SlangRid)\native\slangc.exe</SlangCompiler>
  </PropertyGroup>

  <!-- Top-level (evaluated when LoomShaderSourceDir is known). Entry shaders compile standalone;
       *.module.slang are shared imports (tracked for incremental, never compiled on their own). The glob is
       over SOURCE .slang (which exist at evaluation); the .spv/.json are referenced only as transforms. -->
  <ItemGroup Condition="'$(LoomShaderOutputMode)' != 'None'">
    <LoomSlangEntry  Include="$(LoomShaderSourceDir)\**\*.slang" Exclude="$(LoomShaderSourceDir)\**\*.module.slang;$(LoomShaderExclude)" />
    <LoomSlangModule Include="$(LoomShaderSourceDir)\**\*.module.slang" />
    <LoomSlangSource Include="@(LoomSlangEntry);@(LoomSlangModule)" />

    <!-- Keep the IDE FastUpToDateCheck aware of shader inputs/outputs so it never skips a build and runs
         stale SPIR-V (the classic "my shader edit did nothing" trap) — applies to embedded resources too. -->
    <UpToDateCheckInput Include="@(LoomSlangSource)" />
    <UpToDateCheckBuilt Include="@(LoomSlangEntry->'$(LoomShaderOutDir)%(Filename).spv')" />
    <UpToDateCheckBuilt Include="@(LoomSlangEntry->'$(LoomShaderOutDir)%(Filename).json')" />
  </ItemGroup>

  <!-- Incremental: recompile when ANY .slang (entry OR shared module) is newer than ANY .spv. Listing every
       source as an input means editing a shared *.module.slang rebuilds the shaders that import it. -->
  <Target Name="LoomCompileShaders"
          Condition="'$(LoomShaderOutputMode)' != 'None'"
          Inputs="@(LoomSlangSource)"
          Outputs="@(LoomSlangEntry->'$(LoomShaderOutDir)%(Filename).spv')">
    <Error Condition="'$(PkgSlang_Sdk)' == ''"
           Text="LoomShaderOutputMode='$(LoomShaderOutputMode)' but Slang.Sdk is not referenced in this project. Add a Slang.Sdk PackageReference with GeneratePathProperty=&quot;true&quot;." />
    <Error Condition="!Exists('$(SlangCompiler)')"
           Text="slangc not found at '$(SlangCompiler)'. Is Slang.Sdk restored for RID '$(SlangRid)'? (Only win-x64 / win-arm64 are packaged.)" />
    <MakeDir Directories="$(LoomShaderOutDir)" />
    <Message Importance="high" Text="Slang -&gt; SPIR-V (+reflection): %(LoomSlangEntry.Filename).slang" />
    <!-- Emit reflection JSON beside the SPIR-V (M7-B4): the backend reads it at DefineTechnique to derive
         the descriptor-binding layout, so the app states only pipeline intent. -->
    <Exec Command="&quot;$(SlangCompiler)&quot; &quot;%(LoomSlangEntry.FullPath)&quot; -target spirv -o &quot;$(LoomShaderOutDir)%(LoomSlangEntry.Filename).spv&quot; -reflection-json &quot;$(LoomShaderOutDir)%(LoomSlangEntry.Filename).json&quot;" />

    <!-- DirectX12: also emit SIGNED DXIL here (same target as SPIR-V, so the single LoomCompileShaders dependency
         covers BOTH and the registration below always sees every produced stage — a separate emit target
         ordered before/after caused register to snapshot mid-emit and miss .ps/.cs). Resolve the architecture-
         matched Windows SDK dxc dir for slangc's -dxc-path (forward slashes so a trailing "\" doesn't escape the
         quote in cmd). One Exec per stage, run ONLY for the entry points the shader actually declares
         (detected from its source). A missing stage is skipped — no error to swallow — and a stage that IS
         declared but fails to compile to DXIL HARD-FAILS the build, instead of being silently dropped and
         leaving DirectX12 to fall back to a stand-in (the exact cross-backend break this layer guards against). -->
    <ItemGroup Condition="'$(LoomEmitDxil)' == 'true' And '$(LoomDxcPath)' == ''">
      <_LoomDxcDll Include="$(MSBuildProgramFiles32)\Windows Kits\10\bin\**\$(LoomDxcArch)\dxcompiler.dll" />
    </ItemGroup>
    <PropertyGroup Condition="'$(LoomEmitDxil)' == 'true' And '$(LoomDxcPath)' == ''">
      <LoomDxcPath>@(_LoomDxcDll->'%(RootDir)%(Directory)'->Distinct())</LoomDxcPath>
      <LoomDxcPath>$(LoomDxcPath.Replace('\','/'))</LoomDxcPath>
    </PropertyGroup>
    <Warning Condition="'$(LoomEmitDxil)' == 'true' And '$(LoomDxcPath)' == ''"
             Text="LoomEmitDxil is on but no DXC found (Windows SDK '$(LoomDxcArch)' bin). DirectX12 will fall back to built-in shaders; install the Windows SDK or set $(LoomDxcPath)." />
    <Message Condition="'$(LoomEmitDxil)' == 'true'" Importance="high" Text="Slang -&gt; signed DXIL (per stage): %(LoomSlangEntry.Filename).slang" />
    <ItemGroup Condition="'$(LoomEmitDxil)' == 'true'">
      <_LoomDxilEntry Include="@(LoomSlangEntry)">
        <HasVertex>$([System.IO.File]::ReadAllText('%(FullPath)').Contains('vertexMain'))</HasVertex>
        <HasFragment>$([System.IO.File]::ReadAllText('%(FullPath)').Contains('fragmentMain'))</HasFragment>
        <HasCompute>$([System.IO.File]::ReadAllText('%(FullPath)').Contains('computeMain'))</HasCompute>
      </_LoomDxilEntry>
    </ItemGroup>
    <Exec Condition="'$(LoomEmitDxil)' == 'true' And '%(_LoomDxilEntry.HasVertex)' == 'True'" Command="&quot;$(SlangCompiler)&quot; &quot;%(_LoomDxilEntry.FullPath)&quot; -target dxil -profile sm_6_0 -dxc-path &quot;$(LoomDxcPath)&quot; -entry vertexMain -stage vertex -o &quot;$(LoomShaderOutDir)%(_LoomDxilEntry.Filename).vs.dxil&quot;" />
    <Exec Condition="'$(LoomEmitDxil)' == 'true' And '%(_LoomDxilEntry.HasFragment)' == 'True'" Command="&quot;$(SlangCompiler)&quot; &quot;%(_LoomDxilEntry.FullPath)&quot; -target dxil -profile sm_6_0 -dxc-path &quot;$(LoomDxcPath)&quot; -entry fragmentMain -stage fragment -o &quot;$(LoomShaderOutDir)%(_LoomDxilEntry.Filename).ps.dxil&quot;" />
    <Exec Condition="'$(LoomEmitDxil)' == 'true' And '%(_LoomDxilEntry.HasCompute)' == 'True'" Command="&quot;$(SlangCompiler)&quot; &quot;%(_LoomDxilEntry.FullPath)&quot; -target dxil -profile sm_6_0 -dxc-path &quot;$(LoomDxcPath)&quot; -entry computeMain -stage compute -o &quot;$(LoomShaderOutDir)%(_LoomDxilEntry.Filename).cs.dxil&quot;" />
  </Target>

  <!-- No Inputs/Outputs => ALWAYS runs (even when the compile targets are up to date), so the outputs are
       always registered and never silently dropped from the assembly/output on incremental builds. The
       EmbeddedResource/Content items are added HERE (in a target), not in a top-level ItemGroup, because at
       evaluation time the .spv/.hlsl don't exist yet — a static glob over obj\shaders\ would embed nothing.

       Anchor: BeforeTargets="AssignTargetPaths" for BOTH modes. AssignTargetPaths runs before the resource
       pipeline (SplitResourcesByCulture -> CreateManifestResourceNames) and before Content target-path
       assignment, so items added here flow to Csc (Embed) / to the output (Content). Anchoring at
       BeforeCompile/CoreCompile is TOO LATE for EmbeddedResource — CreateManifestResourceNames has already
       snapshotted @(EmbeddedResource) by then, so the late items never reach the compiler. -->
  <Target Name="LoomRegisterShaders"
          Condition="'$(LoomShaderOutputMode)' != 'None'"
          DependsOnTargets="LoomCompileShaders"
          BeforeTargets="AssignTargetPaths">

    <!-- The per-stage signed-DXIL files actually produced. Enumerated via a Directory.GetFiles property function,
         NOT a "$(LoomShaderOutDir)*.dxil" wildcard Include: MSBuild caches a wildcard item's evaluation (it can
         snapshot a stale/partial directory and miss stages), whereas the property function reads the filesystem
         fresh here — after LoomCompileShaders (via DependsOnTargets) has emitted every stage. -->
    <ItemGroup Condition="'$(LoomEmitDxil)' == 'true'">
      <LoomDxilFile Include="$([System.IO.Directory]::GetFiles('$(LoomShaderOutDir)', '*.dxil'))" />
    </ItemGroup>

    <!-- Content (app): loose .spv/.json (+ signed DXIL) copied to the output under shaders\, flowing to the
         app's bin (and to projects that reference this one). -->
    <ItemGroup Condition="'$(LoomShaderOutputMode)' == 'Content'">
      <Content Include="@(LoomSlangEntry->'$(LoomShaderOutDir)%(Filename).spv')">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <Link>shaders\%(Filename).spv</Link>
        <Visible>false</Visible>
      </Content>
      <Content Include="@(LoomSlangEntry->'$(LoomShaderOutDir)%(Filename).json')">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <Link>shaders\%(Filename).json</Link>
        <Visible>false</Visible>
      </Content>
      <Content Include="@(LoomDxilFile)">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <Link>shaders\%(Filename)%(Extension)</Link>
        <Visible>false</Visible>
      </Content>
    </ItemGroup>

    <!-- Embed (engine): .spv/.json (+ HLSL) become EmbeddedResource with a STABLE flat manifest name the engine
         reads via Assembly.GetManifestResourceStream("<prefix><name>.spv"). The LogicalName is mandatory:
         without it MSBuild derives the name from the obj\shaders\ path (ugly + build-config-dependent). -->
    <ItemGroup Condition="'$(LoomShaderOutputMode)' == 'Embed'">
      <EmbeddedResource Include="@(LoomSlangEntry->'$(LoomShaderOutDir)%(Filename).spv')">
        <LogicalName>$(LoomEmbedManifestPrefix)%(Filename).spv</LogicalName>
        <Visible>false</Visible>
      </EmbeddedResource>
      <EmbeddedResource Include="@(LoomSlangEntry->'$(LoomShaderOutDir)%(Filename).json')">
        <LogicalName>$(LoomEmbedManifestPrefix)%(Filename).json</LogicalName>
        <Visible>false</Visible>
      </EmbeddedResource>
      <!-- WithCulture=false is REQUIRED: a stage suffix like ".ps"/".cs" (blit.ps.dxil, exposure.cs.dxil) is a
           valid culture code (Pashto / Czech), so MSBuild's AssignCulture would otherwise treat the file as a
           satellite-assembly resource and drop it from the main manifest — leaving only ".vs" (not a culture). -->
      <EmbeddedResource Include="@(LoomDxilFile)">
        <LogicalName>$(LoomEmbedManifestPrefix)%(Filename)%(Extension)</LogicalName>
        <WithCulture>false</WithCulture>
        <Visible>false</Visible>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

</Project>
