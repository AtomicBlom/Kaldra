<Project>

  <!--
    Kaldra shared shader-compile machinery (Milestone 8) — property defaults.

    Imported by any project that compiles Slang shaders: directly by BinaryVibrance.Kaldra.Backend.Vulkan (engine shaders, Embed
    mode) and transitively via Sdk.props by an app (the gallery's Kaldra.Sandbox, Content mode). Carries NO backend-reference
    logic, so the engine can import it without pulling in (or self-referencing through) the backend selection.

    A consuming project sets:
      <KaldraShaderSourceDir>   the folder of *.slang sources
      <KaldraShaderOutputMode>  Embed (-> EmbeddedResource, the engine) | Content (-> loose files, an app)
    and adds Slang.Sdk + Microsoft.Direct3D.DXC PackageReferences (both GeneratePathProperty="true")
    for hermetic slangc and hermetic DXC signing respectively.
  -->

  <PropertyGroup>
    <KaldraShaderOutputMode Condition="'$(KaldraShaderOutputMode)' == ''">None</KaldraShaderOutputMode>

    <!-- Also emit SIGNED DXIL beside the SPIR-V (for the DirectX12 backend, which loads the blob — no runtime
         compiler, like the Vulkan .spv). On by default whenever the DirectX12 backend is in the build. Slang's HLSL/
         DXIL target is per-entry-point, so the build emits one signed-DXIL module per stage (vs/ps/cs). -->
    <KaldraEmitDxil Condition="'$(KaldraEmitDxil)' == '' And '$(UseDirectX12)' == 'true'">true</KaldraEmitDxil>
    <KaldraEmitDxil Condition="'$(KaldraEmitDxil)' == ''">false</KaldraEmitDxil>

    <!-- Also emit WGSL beside the SPIR-V (for the WebGPU backend / browser). Unlike DXIL, Slang's WGSL
         target compiles a multi-entry module in one invocation, so one .wgsl per shader. A WGSL-target
         reflection sidecar (<name>.wgsl.json) is emitted too: binding ASSIGNMENTS differ per target
         (WGSL splits each combined Sampler2D into texture+sampler slots and folds the push-constant
         block into an ordinary uniform), so the SPIR-V reflection JSON cannot be reused for layout. -->
    <KaldraEmitWgsl Condition="'$(KaldraEmitWgsl)' == '' And '$(UseWebGPU)' == 'true'">true</KaldraEmitWgsl>
    <KaldraEmitWgsl Condition="'$(KaldraEmitWgsl)' == ''">false</KaldraEmitWgsl>

    <!-- In Content mode, embed the WGSL (and its sidecar) in the assembly rather than copying it loose: for a library
         whose shaders an app picks up, which in the browser it can only do from the library's own assembly. -->
    <KaldraEmbedWgsl Condition="'$(KaldraEmbedWgsl)' == ''">false</KaldraEmbedWgsl>

    <!-- In Content mode, also embed the SPIR-V (and its reflection sidecar) in the assembly, keeping the loose copies:
         for a library whose shaders an Android app picks up, which it can only do from the library's own assembly. -->
    <KaldraEmbedSpirv Condition="'$(KaldraEmbedSpirv)' == ''">false</KaldraEmbedSpirv>

    <!-- Directory of shared cross-project shader includes (kaldra_platform.module.slang: the per-target
         macros: KALDRA_PUSH_CONSTANT, the fullscreen and clip-space positions). Passed to every slangc invocation via -I so app and
         UI shader dirs resolve the same header the engine shaders use. In the repo this is BinaryVibrance.Kaldra.Shaders/Shaders;
         shipped inside the BinaryVibrance.Kaldra.Sdk package (where that repo path doesn't exist) it's the header packed beside
         this file under Shaders/. -->
    <KaldraShaderIncludeDir Condition="'$(KaldraShaderIncludeDir)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\BinaryVibrance.Kaldra.Shaders\Shaders')">$(MSBuildThisFileDirectory)..\..\BinaryVibrance.Kaldra.Shaders\Shaders</KaldraShaderIncludeDir>
    <KaldraShaderIncludeDir Condition="'$(KaldraShaderIncludeDir)' == ''">$(MSBuildThisFileDirectory)Shaders</KaldraShaderIncludeDir>

    <!-- slangc emits DXIL by handing off to DXC, which it loads only from its own module dir or a path we give
         it (NOT the PATH env var). The Microsoft.Direct3D.DXC NuGet package ships architecture-matched
         dxcompiler.dll + dxil.dll; Kaldra.Shaders.targets picks it up via $(PkgMicrosoft_Direct3D_DXC) when the
         consuming project carries that PackageReference with GeneratePathProperty=true. Falls back to the Windows
         SDK if the package is absent. Override the resolved directory via $(KaldraDxcPath). Build-machine only —
         the shipped app carries just the signed .dxil. -->
    <KaldraDxcArch Condition="'$(KaldraDxcArch)' == '' And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString())' == 'Arm64'">arm64</KaldraDxcArch>
    <KaldraDxcArch Condition="'$(KaldraDxcArch)' == ''">x64</KaldraDxcArch>

    <!-- How many slangc runs the compile has going at once (KaldraRunSlang). Empty, as many as there are processors; 1,
         one after another. -->
    <KaldraShaderParallelism Condition="'$(KaldraShaderParallelism)' == ''"></KaldraShaderParallelism>

    <!-- true: every shader compiled again, however up to date. Otherwise each compile runs only when a file it read (the
         shader, a module it imports, slangc) is newer than what it made, or its arguments changed. -->
    <KaldraShaderForce Condition="'$(KaldraShaderForce)' == ''">false</KaldraShaderForce>

    <!-- Optional semicolon-separated list of .slang paths/globs to exclude from compilation (on top of the
         always-excluded *.module.slang). Used to drop ImGui's shader when the engine is built without ImGui. -->
    <KaldraShaderExclude Condition="'$(KaldraShaderExclude)' == ''"></KaldraShaderExclude>

    <!-- Config-agnostic (shaders don't vary by Debug/Release) but RID-qualified: a desktop build emits SPIR-V
         (+DXIL) and a browser build emits WGSL, and without separate output dirs the two collide in one obj —
         building one flavor then the other (without a clean) fails reading the other's artifacts. RuntimeIdentifier
         is a global property set early, so this stays timing-independent. Empty RID (desktop) → obj\shaders\;
         browser-wasm → obj\shaders\browser-wasm\. -->
    <KaldraShaderOutDir Condition="'$(KaldraShaderOutDir)' == ''">$(MSBuildProjectDirectory)\obj\shaders\$(RuntimeIdentifier)\</KaldraShaderOutDir>

    <!-- The manifest-name prefix for Embed mode. Defaults to "<AssemblyName>.Shaders." so the runtime can
         derive the same key from its own assembly name (no hardcoded string drift). -->
    <KaldraEmbedManifestPrefix Condition="'$(KaldraEmbedManifestPrefix)' == ''">$(AssemblyName).Shaders.</KaldraEmbedManifestPrefix>

    <!-- slangc RID: win-x64, or win-arm64 on a Snapdragon dev box. (mac/linux acquisition is a later task.)
         Reproduces the original BinaryVibrance.Kaldra.Shaders.csproj detection verbatim; overridable by setting SlangRid. -->
    <SlangRid Condition="'$(SlangRid)' == '' And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString())' == 'Arm64'">win-arm64</SlangRid>
    <SlangRid Condition="'$(SlangRid)' == ''">win-x64</SlangRid>
  </PropertyGroup>

</Project>
