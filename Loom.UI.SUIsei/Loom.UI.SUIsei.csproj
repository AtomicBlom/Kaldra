<Project Sdk="Microsoft.NET.Sdk">

  <!-- The UI shader (Shaders/ui.slang) lives with this integration, not the engine: the shared shader-compile
       machinery compiles it to loose SPIR-V (+ reflection JSON) and signed DXIL under shaders\, which flow to the
       consuming app's output. The backend resolves it there by the "ui" technique name (its loose-file fallback),
       so a backend built without this package carries no UI shader. Import only the shader-compile machinery —
       NOT the app SDK / backend selection. -->
  <Import Project="..\build\Loom.Sdk\Loom.Shaders.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Loose .spv/.json (+ signed DXIL when the build includes DirectX12) copied to shaders\ and flowed to the app. -->
    <LoomShaderSourceDir>$(MSBuildProjectDirectory)\Shaders</LoomShaderSourceDir>
    <LoomShaderOutputMode>Content</LoomShaderOutputMode>
  </PropertyGroup>

  <!-- Glue between the standalone SUIsei UI runtime and the Loom render graph. References both sides;
       neither SUIsei nor Loom.Core reference each other. -->
  <ItemGroup>
    <ProjectReference Include="..\external\SUIsei\SUIsei\SUIsei.csproj" />
    <ProjectReference Include="..\Loom.Core\Loom.Core.csproj" />
    <ProjectReference Include="..\Loom.Assets\Loom.Assets.csproj" />
    <!-- Hermetic slangc for compiling this package's shader (bundled in the package; win-x64 / win-arm64) — build-only. -->
    <PackageReference Include="Slang.Sdk" GeneratePathProperty="true" PrivateAssets="all" ExcludeAssets="compile;runtime" />
  </ItemGroup>

  <Import Project="..\build\Loom.Sdk\Loom.Shaders.targets" />

</Project>
