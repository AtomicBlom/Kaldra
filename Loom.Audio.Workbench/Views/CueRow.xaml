<?xml version="1.0" encoding="utf-8"?>
<!-- A cue: its name, then a slider from 0 to 1 and its value for a level, or a button per option for a choice. -->
<ContentControl xmlns="https://github.com/AtomicBlom/SUIsei/ui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                x:Class="Loom.Audio.Workbench.Views.CueRow"
                IsTabStop="False" Margin="0,0,0,6">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="48" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="NameLabel" Grid.Column="0" FontSize="14" VerticalAlignment="Center" />
        <Slider x:Name="ValueSlider" Grid.Column="1" Minimum="0" Maximum="1" StepFrequency="0.01" Height="32" />
        <TextBlock x:Name="ValueLabel" Grid.Column="2" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0" />
        <StackPanel x:Name="Options" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Visibility="Collapsed" />
    </Grid>
</ContentControl>
