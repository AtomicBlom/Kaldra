<?xml version="1.0" encoding="utf-8"?>
<!--
    A track: its name, mute and solo, its gain from −24 to +6 dB, a meter of its level (48 dB across), and its parts
    under it, indented.
-->
<ContentControl xmlns="https://github.com/AtomicBlom/SUIsei/ui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                x:Class="Loom.Audio.Workbench.Views.TrackRow"
                IsTabStop="False" Margin="0,0,0,8">
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="NameLabel" Grid.Column="0" FontSize="15" VerticalAlignment="Center" />
            <ToggleButton x:Name="MuteButton" Grid.Column="1" Width="34" Margin="0,0,4,0">
                <TextBlock Text="M" FontSize="13" HorizontalAlignment="Center" />
            </ToggleButton>
            <ToggleButton x:Name="SoloButton" Grid.Column="2" Width="34" Margin="0,0,8,0">
                <TextBlock Text="S" FontSize="13" HorizontalAlignment="Center" />
            </ToggleButton>
            <Slider x:Name="GainSlider" Grid.Column="3" Minimum="-24" Maximum="6" StepFrequency="0.5" Height="30" />
            <Border x:Name="MeterBack" Grid.Column="4" Height="8" Margin="10,0,0,0" CornerRadius="4" VerticalAlignment="Center">
                <Border x:Name="MeterFill" HorizontalAlignment="Left" CornerRadius="4" Width="0" />
            </Border>
        </Grid>
        <StackPanel x:Name="Placements" Margin="18,4,0,0" />
    </StackPanel>
</ContentControl>
