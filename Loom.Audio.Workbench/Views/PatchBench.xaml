<?xml version="1.0" encoding="utf-8"?>
<!--
    Patch: the patch chosen in the library, played from the keyboard docked below, with its eight macros as sliders.
-->
<ContentControl xmlns="https://github.com/AtomicBlom/SUIsei/ui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:wb="using:Loom.Audio.Workbench"
                xmlns:views="using:Loom.Audio.Workbench.Views"
                x:Class="Loom.Audio.Workbench.Views.PatchBench"
                IsTabStop="False">
    <ScrollViewer>
        <StackPanel Margin="12,10,16,12">
            <TextBlock Text="{x:Bind ViewModel.DockLabel, Mode=OneWay}" FontSize="16" Foreground="{x:Static views:Theme.Ink}" Margin="0,0,0,4" />
            <TextBlock Text="Play it from the keyboard below, or A W S E D F T G Y H U J K." FontSize="12"
                       Foreground="{x:Static views:Theme.Dim}" Margin="0,0,0,12" />
            <TextBlock Text="MACROS" FontSize="10" Foreground="{x:Static views:Theme.Faint}" Margin="0,0,0,6" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Macros, Mode=OneWay}"
                          Visibility="{x:Bind views:Display.Chosen(ViewModel.SelectedPatch), Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="wb:MacroViewModel">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Bind Name}" FontSize="12" Foreground="{x:Static views:Theme.Dim}" Width="70"
                                       VerticalAlignment="Center" />
                            <Slider Minimum="0" Maximum="1" StepFrequency="0.01" Width="260" Height="26" Value="{x:Bind Value, Mode=TwoWay}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</ContentControl>
