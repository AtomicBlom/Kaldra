<?xml version="1.0" encoding="utf-8"?>
<!--
    The song's sections: a button each, the one playing lit, a click jumping to it at the next bar (lit once the jump is
    heard); and the loop.
-->
<ContentControl xmlns="https://github.com/AtomicBlom/SUIsei/ui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:wb="using:Loom.Audio.Workbench"
                xmlns:views="using:Loom.Audio.Workbench.Views"
                x:Class="Loom.Audio.Workbench.Views.SectionStrip"
                IsTabStop="False">
    <StackPanel>
        <TextBlock Text="Sections" FontSize="13" Foreground="{x:Static views:Theme.Dim}" Margin="0,0,0,6" />
        <ItemsControl ItemsSource="{x:Bind ViewModel.Sections, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="wb:SectionViewModel">
                    <ToggleButton IsChecked="{x:Bind IsCurrent, Mode=TwoWay}" Margin="0,0,4,4">
                        <TextBlock Text="{x:Bind Label}" FontSize="13" Margin="8,3,8,4" HorizontalAlignment="Center" />
                    </ToggleButton>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <CheckBox IsChecked="{x:Bind ViewModel.LoopSection, Mode=TwoWay}" Content="Loop the section playing" Margin="0,8,0,0" />
    </StackPanel>
</ContentControl>
