<?xml version="1.0" encoding="utf-8"?>
<!-- A part: a dot lit while it plays, its name and condition, and auto, on and off. A click on it shows it in the pattern. -->
<ContentControl xmlns="https://github.com/AtomicBlom/SUIsei/ui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                x:Class="Loom.Audio.Workbench.Views.PlacementRow"
                IsTabStop="False" Margin="0,0,0,3">
    <Grid x:Name="Row">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Ellipse x:Name="Dot" Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="NameLabel" FontSize="13" />
            <TextBlock x:Name="ConditionLabel" FontSize="11" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal">
            <ToggleButton x:Name="AutoButton" Width="46" Margin="0,0,3,0">
                <TextBlock Text="auto" FontSize="11" HorizontalAlignment="Center" />
            </ToggleButton>
            <ToggleButton x:Name="OnButton" Width="36" Margin="0,0,3,0">
                <TextBlock Text="on" FontSize="11" HorizontalAlignment="Center" />
            </ToggleButton>
            <ToggleButton x:Name="OffButton" Width="36">
                <TextBlock Text="off" FontSize="11" HorizontalAlignment="Center" />
            </ToggleButton>
        </StackPanel>
    </Grid>
</ContentControl>
