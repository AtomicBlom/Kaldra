<Solution>
  <!-- The Android half of Loom: the Android host, the gallery's Android head, the Android sample, and the engine layers
       and gallery they reference. Kept separate from Loom.slnx so the android workload (net11.0-android) stays off the
       desktop build, but present here so Roslyn tooling can load and analyse the Android projects. -->
  <Project Path="external/SUIsei/SUIsei/SUIsei.csproj" />
  <Project Path="Loom.Assets/Loom.Assets.csproj" />
  <Project Path="Loom.Audio/Loom.Audio.csproj" />
  <Project Path="Loom.Backend.Vulkan/Loom.Backend.Vulkan.csproj" />
  <Project Path="Loom.Concepts/Loom.Concepts.csproj" />
  <Project Path="Loom.Core/Loom.Core.csproj" />
  <Project Path="Loom.Gallery/Loom.Gallery.csproj" />
  <Project Path="Loom.Graph/Loom.Graph.csproj" />
  <Project Path="Loom.Hosting.Android/Loom.Hosting.Android.csproj" />
  <Project Path="Loom.Input/Loom.Input.csproj" />
  <Project Path="Loom.Sandbox.Android/Loom.Sandbox.Android.csproj" />
  <Project Path="Loom.UI.ImGui/Loom.UI.ImGui.csproj" />
  <Project Path="Loom.UI.SUIsei/Loom.UI.SUIsei.csproj" />
  <Project Path="samples/HelloAudio/HelloAudio.csproj" />
  <Project Path="samples/HelloUI/HelloUI.csproj" />
</Solution>
