<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Loom.Shaders compiles Slang (.slang) -> SPIR-V (.spv) OFFLINE via slangc, hermetically:
    slangc ships inside the Slang.Sdk NuGet, so build agents need nothing pre-installed.
    Windows-only RIDs for now (win-x64 / win-arm64); mac/linux acquisition is a later task.

    GeneratePathProperty gives $(PkgSlang_Sdk); ExcludeAssets keeps the Slang bindings out of
    this project's compile/runtime surface (we only invoke the bundled slangc.exe).
  -->
  <ItemGroup>
    <PackageReference Include="Slang.Sdk" Version="0.5.1"
                      GeneratePathProperty="true" PrivateAssets="all" ExcludeAssets="compile;runtime" />
  </ItemGroup>

  <PropertyGroup>
    <SlangRid>win-x64</SlangRid>
    <SlangRid Condition="$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString()) == 'Arm64'">win-arm64</SlangRid>
    <SlangCompiler>$(PkgSlang_Sdk)\runtimes\$(SlangRid)\native\slangc.exe</SlangCompiler>
    <ShaderSourceDir>$(MSBuildProjectDirectory)\Shaders</ShaderSourceDir>
    <!-- Timing-independent (MSBuildProjectDirectory is always set; IntermediateOutputPath is
         finalized too late for a body PropertyGroup). Shaders are config-agnostic. -->
    <ShaderOutDir>$(MSBuildProjectDirectory)\obj\shaders\</ShaderOutDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Entry-point shaders are compiled standalone; *.module.slang are shared imports
         (tracked for incremental, but not compiled on their own). -->
    <SlangShaderEntry Include="$(ShaderSourceDir)\**\*.slang" Exclude="$(ShaderSourceDir)\**\*.module.slang" />
    <SlangShaderModule Include="$(ShaderSourceDir)\**\*.module.slang" />
    <SlangShaderSource Include="@(SlangShaderEntry);@(SlangShaderModule)" />

    <!-- Make the IDE's FastUpToDateCheck aware of shader inputs/outputs so it never skips
         a build and runs stale .spv (a classic source of "my shader edit did nothing"). -->
    <UpToDateCheckInput Include="@(SlangShaderSource)" />
    <UpToDateCheckBuilt Include="@(SlangShaderEntry->'$(ShaderOutDir)%(Filename).spv')" />
  </ItemGroup>

  <!--
    Incremental: recompile when ANY .slang (entry OR shared module) is newer than ANY .spv.
    Listing every source as an input means editing a shared *.module.slang rebuilds the shaders
    that import it - the classic "changed an include, didn't rebuild" trap, avoided. (Per-shader
    precision via `slangc -depfile` is a later optimization; correctness first.)
  -->
  <Target Name="CompileShaders"
          BeforeTargets="AssignTargetPaths"
          Inputs="@(SlangShaderSource)"
          Outputs="@(SlangShaderEntry->'$(ShaderOutDir)%(Filename).spv')">
    <Error Condition="!Exists('$(SlangCompiler)')"
           Text="slangc not found at '$(SlangCompiler)'. Is Slang.Sdk restored for RID '$(SlangRid)'? (Only win-x64 / win-arm64 are packaged.)" />
    <MakeDir Directories="$(ShaderOutDir)" />
    <Message Importance="high" Text="Slang -> SPIR-V: %(SlangShaderEntry.Filename).slang" />
    <Exec Command="&quot;$(SlangCompiler)&quot; &quot;%(SlangShaderEntry.FullPath)&quot; -target spirv -o &quot;$(ShaderOutDir)%(SlangShaderEntry.Filename).spv&quot;" />
  </Target>

  <!-- Always runs (even when CompileShaders is up to date) so the .spv are registered as content
       and flow to this project's output and to referencing projects (e.g. Loom.Sandbox) under shaders\. -->
  <Target Name="IncludeCompiledShaders"
          BeforeTargets="AssignTargetPaths"
          DependsOnTargets="CompileShaders">
    <ItemGroup>
      <Content Include="@(SlangShaderEntry->'$(ShaderOutDir)%(Filename).spv')">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <Link>shaders\%(Filename).spv</Link>
        <Visible>false</Visible>
      </Content>
    </ItemGroup>
  </Target>

</Project>
