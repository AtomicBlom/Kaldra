<Project Sdk="Microsoft.NET.Sdk">

  <!-- XAML -> typed control-tree generator wiring: the Phase C end-to-end proof (Sample/SampleView.xaml)
       is generated and constructed by the tests in this project. -->
  <Import Project="..\build\Loom.Sdk\Loom.UI.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- TUnit runs on Microsoft.Testing.Platform, whose source generator emits the executable entry point.
         `dotnet test` is routed to MTP (not the removed VSTest bridge) by the repo-root dotnet.config. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="Shouldly" />
    <!-- Drive Loom.UI.SourceGen directly (CSharpGeneratorDriver) to unit-test the diagnostics and incremental
         caching that the build-time analyzer path can't exercise (invalid XAML would break this project's own build). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="TUnit.Core" />
    <Using Include="Shouldly" />
  </ItemGroup>

  <!-- The neutral UI runtime + the neutral layers it builds on; NO backend reference (the headless-testable
       invariant — PlanningUI.md §D8.3, mirroring Loom.Tests' no-Vulkan/DirectX12 rule). -->
  <ItemGroup>
    <ProjectReference Include="..\Loom.UI\Loom.UI.csproj" />
    <ProjectReference Include="..\Loom.Core\Loom.Core.csproj" />
    <ProjectReference Include="..\Loom.Assets\Loom.Assets.csproj" />
  </ItemGroup>

  <Import Project="..\build\Loom.Sdk\Loom.UI.targets" />

  <!-- The SDK registers the generator as a build-time analyzer with ReferenceOutputAssembly=false (never a runtime
       dependency for real consumers). Flip it to true for this test project only, so the XamlSourceGenerator type
       is referenceable by the CSharpGeneratorDriver-based tests. Update (not a second ProjectReference) so the
       generator is still registered exactly once as an analyzer. -->
  <ItemGroup>
    <ProjectReference Update="..\Loom.UI.SourceGen\Loom.UI.SourceGen.csproj" ReferenceOutputAssembly="true" />
  </ItemGroup>

</Project>
