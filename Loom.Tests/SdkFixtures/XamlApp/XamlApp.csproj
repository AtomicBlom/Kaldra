<Project Sdk="Microsoft.NET.Sdk">

  <!-- A Loom app that turns SUIsei on through the Loom SDK and authors one .xaml view, nothing else. SdkXamlTests
       builds it (it is in no solution): the SDK must hand it SUIsei's XAML generator, so the view's code-behind,
       which calls the generated InitializeComponent and reads a typed x:Name field, compiles at all. -->
  <Import Project="..\..\..\build\Loom.Sdk\Sdk\Sdk.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <UseSUIsei>true</UseSUIsei>
    <!-- No shaders of its own. -->
    <LoomShaderOutputMode>None</LoomShaderOutputMode>
    <!-- Keep the generated tree on disk, so a test can see what the generator wrote. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <Import Project="..\..\..\build\Loom.Sdk\Sdk\Sdk.targets" />

</Project>
