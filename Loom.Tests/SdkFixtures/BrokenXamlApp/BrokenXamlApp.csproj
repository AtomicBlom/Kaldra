<Project Sdk="Microsoft.NET.Sdk">

  <!-- XamlApp's twin with one XAML error in its only view. SdkXamlTests builds it (it is in no solution) to see that
       SUIsei's generator reports the error against the .xaml's own file and line, so the build fails there. -->
  <Import Project="..\..\..\build\Loom.Sdk\Sdk\Sdk.props" />

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <UseSUIsei>true</UseSUIsei>
    <UseLoomHost>false</UseLoomHost>
    <LoomShaderOutputMode>None</LoomShaderOutputMode>
  </PropertyGroup>

  <Import Project="..\..\..\build\Loom.Sdk\Sdk\Sdk.targets" />

</Project>
