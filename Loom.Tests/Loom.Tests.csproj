<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- TUnit runs on Microsoft.Testing.Platform, whose source generator emits the executable entry point.
         `dotnet test` is routed to MTP (not the removed VSTest bridge) by the repo-root dotnet.config. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="TUnit.Core" />
    <Using Include="Shouldly" />
  </ItemGroup>

  <!-- M13 golden-image baselines: committed reference PNGs, copied beside the test assembly so GoldenImageTests
       can read them at runtime (the matching fresh captures come from tools/golden.ps1 via LOOM_GOLDEN_DIR). -->
  <ItemGroup>
    <Content Include="Goldens\**\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- M15: the committed rigged-bar glTF (one source of truth in the sandbox's assets), linked beside the test
       assembly so GltfSkinningLoadTests can load it through GltfLoader. -->
  <ItemGroup>
    <Content Include="..\Loom.Sandbox\Assets\rigged_bar.glb" Link="rigged_bar.glb" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Describe + Execute layers: both backend-neutral, never the Vulkan backend. -->
  <ItemGroup>
    <ProjectReference Include="..\Loom.Core\Loom.Core.csproj" />
    <ProjectReference Include="..\Loom.Graph\Loom.Graph.csproj" />
    <ProjectReference Include="..\Loom.Assets\Loom.Assets.csproj" />
    <ProjectReference Include="..\Loom.Concepts\Loom.Concepts.csproj" />
    <ProjectReference Include="..\Loom.Input\Loom.Input.csproj" />
  </ItemGroup>

  <!-- Referenced so their module initializers self-register into Engine.AvailableEngines (each guarded by its own
       IsSupported() probe — a box/OS lacking one degrades to it simply not appearing, never a build/runtime
       failure) for OffscreenEngineTests, which is GPU-gated and skips whichever backend isn't present. -->
  <ItemGroup>
    <ProjectReference Include="..\Loom.Backend.Vulkan\Loom.Backend.Vulkan.csproj" />
    <ProjectReference Include="..\Loom.Backend.DirectX12\Loom.Backend.DirectX12.csproj" />
  </ItemGroup>

</Project>
