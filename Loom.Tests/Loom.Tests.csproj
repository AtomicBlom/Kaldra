<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- TUnit runs on Microsoft.Testing.Platform, whose source generator emits the executable entry point.
         `dotnet test` is routed to MTP (not the removed VSTest bridge) by the repo-root dotnet.config. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="TUnit.Core" />
    <Using Include="Shouldly" />
  </ItemGroup>

  <!-- Golden-image baselines: committed reference PNGs, copied beside the test assembly so GalleryGoldenTests
       can read them at runtime. LOOM_GOLDEN_UPDATE (or tools/golden.ps1 -Update) regenerates them in the source tree. -->
  <ItemGroup>
    <Content Include="Goldens\**\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Apps SdkXamlTests builds through the Loom SDK, each its own project (in no solution): none of their sources,
       nor what their builds leave under them, are this project's. -->
  <ItemGroup>
    <Compile Remove="SdkFixtures\**" />
    <None Remove="SdkFixtures\**" />
  </ItemGroup>

  <!-- The committed rigged-bar glTF (one source of truth in the gallery's assets), linked beside the test
       assembly so GltfSkinningLoadTests can load it through GltfLoader. -->
  <ItemGroup>
    <Content Include="..\Loom.Gallery\Assets\rigged_bar.glb" Link="rigged_bar.glb" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Describe + Execute layers: both backend-neutral, never the Vulkan backend. -->
  <ItemGroup>
    <ProjectReference Include="..\Loom.Core\Loom.Core.csproj" />
    <ProjectReference Include="..\Loom.Graph\Loom.Graph.csproj" />
    <ProjectReference Include="..\Loom.Assets\Loom.Assets.csproj" />
    <ProjectReference Include="..\Loom.Concepts\Loom.Concepts.csproj" />
    <ProjectReference Include="..\Loom.Input\Loom.Input.csproj" />
  </ItemGroup>

  <!-- The demo gallery: the in-process golden/parity tests render its scenes offscreen (GPU-gated), and its
       compiled shaders (+ signed DXIL) flow beside the test assembly under shaders\ through this reference. -->
  <ItemGroup>
    <ProjectReference Include="..\Loom.Gallery\Loom.Gallery.csproj" />
  </ItemGroup>

  <!-- SUIsei's software rasterizer, the CPU oracle for every UI prim: the vector prim's GPU render is diffed against
       it (VectorPrimRenderTests), which is what holds ui.slang to the same maths. -->
  <ItemGroup>
    <ProjectReference Include="..\external\SUIsei\SUIsei.Rasterizer\SUIsei.Rasterizer.csproj" />
  </ItemGroup>

  <!-- The desktop host, for the backend-neutral host-machinery tests (HostOptions launch-option parsing). No GPU
       and no window are created — only the pure parser is exercised. -->
  <ItemGroup>
    <ProjectReference Include="..\Loom.Hosting.Desktop\Loom.Hosting.Desktop.csproj" />
  </ItemGroup>

  <!-- Referenced so their module initializers self-register into Backends.Available (each guarded by its own
       IsSupported() probe — a box/OS lacking one degrades to it simply not appearing, never a build/runtime
       failure) for OffscreenEngineTests, which is GPU-gated and skips whichever backend isn't present. -->
  <ItemGroup>
    <ProjectReference Include="..\Loom.Backend.Vulkan\Loom.Backend.Vulkan.csproj" />
    <ProjectReference Include="..\Loom.Backend.DirectX12\Loom.Backend.DirectX12.csproj" />
  </ItemGroup>

</Project>
