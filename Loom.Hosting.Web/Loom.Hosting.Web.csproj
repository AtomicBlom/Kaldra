<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Browser application host: brings up the WebGPU device on a JS-supplied canvas and drives a
       LoomApplication's frame loop. Razor SDK (RCL) so it ships static web assets — chiefly wwwroot/loom-boot.js,
       the reusable browser boot helper served at _content/Loom.Hosting.Web/loom-boot.js. The default HTML shell
       (build/defaults/index.html + main.js) is NOT a static web asset (those land under _content/); it is
       injected into a consuming app's wwwroot ROOT, only when the app authored none of its own, by the
       copy-if-absent target in build/Loom.Hosting.Web.targets. No Razor components are compiled here. -->

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The [JSImport]/[JSExport] source generators emit unsafe marshaling code (same as the WebGPU backend). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- The host's [JSImport]/[JSExport] surface is browser-only; declaring the platform lets CA1416 verify the guards. -->
  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <PropertyGroup Label="NuGet">
    <PackageId>Loom.Hosting.Web</PackageId>
    <Description>Browser (WebAssembly) application host for the Loom render-graph engine — WebGPU device bring-up on a page-supplied canvas + a requestAnimationFrame frame loop behind LoomApplication.Run, plus a default full-screen HTML shell you can opt out of.</Description>
    <PackageTags>webgpu;wasm;browser;rendergraph;gamedev;hosting;dotnet</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Loom.Core\Loom.Core.csproj" />
    <!-- The web host constructs the WebGPU backend directly (module initializers are unreliable under WASM AOT),
         so it references the backend package; loom-webgpu.js travels with that backend as a static web asset. -->
    <ProjectReference Include="..\Loom.Backend.WebGPU\Loom.Backend.WebGPU.csproj" />
  </ItemGroup>

  <!-- Package the default-shell files + the injection target so a NuGet consumer gets copy-if-absent behaviour
       auto-imported (build/<PackageId>.targets convention). In-repo consumers import the same target explicitly
       via the Loom SDK. -->
  <ItemGroup>
    <None Include="build\Loom.Hosting.Web.targets" Pack="true" PackagePath="build\Loom.Hosting.Web.targets" />
    <None Include="build\defaults\index.html" Pack="true" PackagePath="build\defaults\index.html" />
    <None Include="build\defaults\main.js" Pack="true" PackagePath="build\defaults\main.js" />
  </ItemGroup>

</Project>
