<Project>

  <!--
    Copy-if-absent default web shell. When a browser-wasm app references BinaryVibrance.Kaldra.Hosting.Web but authored no
    wwwroot/index.html of its own, inject the framework's default full-screen shell (index.html + main.js) into
    the app's wwwroot ROOT so it produces a runnable page from pure C#. Authoring your own wwwroot/index.html is
    the opt-out — the Exists() guard then skips this entirely.

    Content with Link="wwwroot\..." is what makes a file outside wwwroot a ROOT static web asset of the
    consuming app (base path "/"), as opposed to a referenced package's _content/ assets. The files sit beside
    this targets file (build/defaults/) so the same relative path resolves whether this is imported from the
    NuGet package's build/ folder (auto-imported for package consumers) or from the repo (imported by the Kaldra
    SDK for source-mode consumers).
  -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'browser-wasm' and !Exists('$(MSBuildProjectDirectory)\wwwroot\index.html')">
    <Content Include="$(MSBuildThisFileDirectory)defaults\index.html" Link="wwwroot\index.html" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(MSBuildThisFileDirectory)defaults\main.js" Link="wwwroot\main.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
